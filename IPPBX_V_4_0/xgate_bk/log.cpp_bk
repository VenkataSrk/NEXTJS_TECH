//-----------------------------------------------------------------------------
// Write Windows error
void CLog::SysLastError(const char *sender, const char *msgfmt, ...)
{
    cout << "**** Inside Clog::SysLastError ****" << endl;
    #ifdef LOGENABLE
    if((!KLog::Instance()) || (sender == NULL))return;
    assert(KLog::Instance());
    if (!msgfmt)
	return;

    char m_StrBuf2[ LOG_MAX_MSG ], 
	 m_StrBuf3[ LOG_MAX_MSG ];

    //int err = GetLastError();
    int err = task->GetLastError(); //linux porting

    if (err == 0)
	err = MINISOCK_LAST_ERROR;

    int ret = strerror(err); //linux porting

    if (!ret) {
		_snprintf( m_StrBuf2, LOG_MAX_MSG, "GetLastError = %u (0x%X)", err, err);
    } else {
	// The last char normally is newline.
	m_StrBuf2[ret-1] = '\0';
    }


    va_list marker;

    va_start(marker, msgfmt);
    _vsnprintf( m_StrBuf3, LOG_MAX_MSG, msgfmt, marker);
    va_end(marker);
    strcat( m_StrBuf3, ": %s");


    CLog::Error( sender, (CTask*)0, m_StrBuf3, m_StrBuf2);
	#endif

};


//-----------------------------------------------------------------------------
// Write Windows error
void CLog::SysLastError(const char *sender, CTask *task, const char *msgfmt, ...)
{
    #ifdef LOGENABLE
    if((!KLog::Instance()) || (sender == NULL))return;

    assert(KLog::Instance());
    if (!msgfmt)
	return;

    char m_StrBuf2[ LOG_MAX_MSG ], 
	 m_StrBuf3[ LOG_MAX_MSG ];

    //int err = GetLastError();
    int err = task->GetLastError();
    if (err == 0)
	err = MINISOCK_LAST_ERROR;	//linux porting

    int ret = strerror(err); //linux porting
    if (!ret) {
	_snprintf( m_StrBuf2, LOG_MAX_MSG, "GetLastError = %u (0x%X)", err, err);
    } else {
	// The last char normally is newline.
	m_StrBuf2[ret-1] = '\0';
    }

    va_list marker;

    va_start(marker, msgfmt);
    _vsnprintf( m_StrBuf3, LOG_MAX_MSG, msgfmt, marker);
    va_end(marker);
    strcat( m_StrBuf3, ": %s");


    CLog::Error( sender, task, m_StrBuf3, m_StrBuf2);
	#endif
};


