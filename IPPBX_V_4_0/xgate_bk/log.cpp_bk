//#include "stdafx.h"
#include "klog.h"
#include "task.h"
#include <string.h>

//#define LOGENABLE 0

class CTask;
CTask *task;

void PrintLog( LogVerbosity level, const char *sender, CTask *task, const char *format, va_list &marker)
{
    #ifdef LOGENABLE
    CLog::Write( level, sender, task, format, marker);
	#endif
}

void PrintLog( LogVerbosity level, const char *sender, const char *message)
{
    #ifdef LOGENABLE
    CLog::Log( level, sender, (CTask*)0, message);
	#endif

}

//-----------------------------------------------------------------------------
void CLog::Write( LogVerbosity level, const char *sender, const char *format, va_list marker1)
{
    #ifdef LOGENABLE
    CTask *task;

    if((!KLog::Instance()) || (sender == NULL))return;
	assert(KLog::Instance());
    va_list marker;	//linux porting
    KLog::Instance()->Log( level, sender, (CTask*)0, format, marker);
	#endif
};


//-----------------------------------------------------------------------------
void CLog::Write( LogVerbosity level, const char *sender, CTask *task, const char *format, va_list marker1)
{
    #ifdef LOGENABLE
    if((!KLog::Instance()) || (sender == NULL))return;
    assert(KLog::Instance());
    va_list marker;	//linux porting
    KLog::Instance()->Log( level, sender, task, format, marker);
	#endif
};

//-----------------------------------------------------------------------------
void CLog::Log( LogVerbosity level, const char *sender, const char *format, ...)
{
//	printf("************ Inside CLog::Log **************\n");
 //   #ifdef LOGENABLE
    if((!KLog::Instance()) || (sender == NULL))return;
    assert(KLog::Instance());
    va_list marker;

    va_start(marker,format);
//	printf("************ Inside CLog::Log  calling KLog::Log  **************\n");
    KLog::Instance()->Log( level, sender, (CTask*)0, format, marker);
    va_end(marker);
//	#endif
};


//-----------------------------------------------------------------------------
void CLog::Log( LogVerbosity level, const char *sender, CTask *task, const char *format, ...)
{
//	printf("************ Inside CLog::Log 1111 **************\n");
//    #ifdef LOGENABLE
    if((!KLog::Instance()) || (sender == NULL))return;
    assert(KLog::Instance());
    va_list marker;

    va_start(marker,format);
//	printf("************ Inside CLog::Log 1111 calling KLog::Log **************\n");
    KLog::Instance()->Log( level, sender, task, format, marker);
    va_end(marker);
//	#endif
};


