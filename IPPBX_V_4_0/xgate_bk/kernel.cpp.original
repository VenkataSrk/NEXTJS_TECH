	cmd_spawntask->Add (new Term_Cmd_Arg ( "cmdline_arg3", CVariant(""), CVariantValidator("", "Command line argument 3"), TermArgOptional));
	cmd_spawntask->Add (new Term_Cmd_Arg ( "cmdline_arg4", CVariant(""), CVariantValidator("", "Command line argument 4"), TermArgOptional));

