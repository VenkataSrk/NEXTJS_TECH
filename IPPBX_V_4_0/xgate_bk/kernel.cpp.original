//-----------------------------------------------------------------------------
// Kernel information/statistics
//
class CKernelInfo {

	public:
		// Statistics that need not to be cleared
		unsigned long   m_TotalTask;	// total tasks spawned
		unsigned int    m_NConcurrentTask;
		unsigned int    m_NBlockedTask;
		unsigned int    m_NReadyTask;
		unsigned int    m_NBornTask;
		time_t	    m_Started;

		// Clearable statistics begins here.
		char	    m_ClearableBegin;

		unsigned long   m_HighTask,			// highest number of concurrent task running
						m_MSLongTaskUp,		// longest running task
						m_MSLongTaskExec,		// longest task exec before blocked
						m_MSLongTaskBlocked,	// longest task blocking time
						m_MSLongTaskWaiting,	// longest task waiting time
						m_MSLongTaskTotalExec,	// longest task's total execution time
						m_TotalTaskInAvg,		// total tasks counted in avg. waiting calculation
						m_MSAvgTaskWaiting,		// average task waiting time
						m_MSAvgTaskLongestExec,	// average longest task exec.
						m_MSAvgTaskTotalExec;	// average total task execution time

		unsigned	    m_KPollPerSec,	// loop per sec
						m_HighPoll,		// highest LPS
						m_LowPoll;		// lowest LPS

		unsigned	    m_CtxPerSec,	// context switch per sec
						m_HighCtx,		// highest ctx/sec
						m_LowCtx;		// lowest ctx/sec

		char	    m_LongTaskUpName[32],
					m_LongTaskBlockedName[32],
					m_LongTaskWaitingName[32],
					m_LongTaskExecName[32],
					m_LongTaskTotalExecName[32],
					m_LongDriverExecName[32];

		time_t	    m_LastReset,
					m_HighTaskAt;

		time_t	    m_LongTaskWaitingAt,
					m_HighPollAt,
					m_LowPollAt,
					m_HighCtxAt,
					m_LowCtxAt;


		// this MUST be the last variables declared.
		char	    m_ClearableEnd;

		// Constructor
		CKernelInfo() 
		{ 
			memset(this, 0, sizeof(*this));
			Reset(); 
			m_LastReset = 0;
			time(&m_Started); 
		}

		void Reset() {
			memset(&m_ClearableBegin, 0, &m_ClearableEnd - &m_ClearableBegin );

			time( &m_LastReset );
			m_CtxPerSec = m_KPollPerSec = 500;
			m_HighCtx = m_HighPoll = 0;
			m_LowCtx = m_LowPoll = 1000;
		}
};


//-----------------------------------------------------------------------------
// This is a simple ServiceProvider, whose sole purpose is to clear kernel
// statistics.
//
class Kernel_Reset_Stat : public ServiceProvider {

	public:
		Kernel_Reset_Stat()
			: ServiceProvider("statistics", false, false) {}
		virtual bool Load() {
			return true;
		}
		virtual bool Unload() {
			return true;
		}
		virtual void OnClearCounter() {
			Kernel::Instance()->ResetStat();
		}

};


//------------------------------------------------------------------------------
// This service provider regularly checks the sanity of the system (using a 
// separate thread)
//
class Sanity_Checker : public ServiceProvider
{
	public:
		Sanity_Checker() : ServiceProvider("SanityChecker", false, false)
	{
		_quit = false;
	}

		virtual bool Load()
		{
			//SPAWN_THREAD(&thread_proc, this, THR_NEW_LWP|THR_JOINABLE, NULL, &_hThread);
			return true;
		}

		virtual bool Unload() 
		{
			_quit = true;
			ACE_Thread::join(_hThread);
			return true;
		}

		void MainLoop()
		{
			while (!_quit)
			{
				// wait 10 seconds
				for (int i=0; i<10 && !_quit; i++)
					Sleep(1000); //Linux Porting

				if (_quit)
					break;


				/* Linux Porting */
#ifdef KERNEL_RECORD_ACQUIRE_LOCK
				// try to acquire system lock for 1000msec
				/* if (::WaitForSingleObject(Kernel::Instance()->m_SystemLock, 1000) == WAIT_TIMEOUT) */
				if ((pthread_cond_timedwait(&Kernel::Instance()->m_Pcondevent, &Kernel::Instance()->m_SystemLock, &Kernel::Instance()->m_Mutexts)) == ETIMEDOUT) { //Linux Porting


				} else {
					//Linux Porting
					//::ReleaseMutex (Kernel::Instance()->m_SystemLock);
					pthread_mutex_unlock (&(Kernel::Instance()->m_SystemLock));
				}
#endif
			}
		}

		static void* thread_proc(void *this_instance)
		{
			Sanity_Checker* self = (Sanity_Checker*)this_instance;
			self->MainLoop();
			return NULL;
		}

	private:
		bool _quit;
		ACE_hthread_t _hThread;
};


#ifdef XGATE_HAS_BUGSLAYER
class Kernel_BugSlayer_Checker : public ServiceProvider {
	public:
		enum
		{
			CHECK_PERIOD = 3600*24*2,	/* Perform checkpoint every this second */
		};

		Kernel_BugSlayer_Checker()
			: ServiceProvider("bug-check", false, true, Lowest_Priority) 
		{
			last_checkpoint_ = time(NULL);
			instance_ = this;
		}

		~Kernel_BugSlayer_Checker()
		{
			instance_ = NULL;
		}

		static Kernel_BugSlayer_Checker *Instance()
		{
			return instance_;
		}

		void Checkpoint(bool print_if_ok)
		{
			int status=bs_checkpoint(0);

			last_checkpoint_ = time(NULL);

			switch (status) {
				case BS_CHECK_OK:
					if (print_if_ok) {
						CLog::Info( KERNEL, "BugSlayer integrity checked OK.");
					} else {
						CLog::Debug( KERNEL, "BugSlayer integrity checked OK.");
					}
					break;
				case BS_CHECK_WARNING:
					CLog::Info(KERNEL, "BugSlayer integrity OK, but some node(s) have errors."
							"The nodes have been successfully repaired. See bugslayer.log "
							"for detailed information.");
					break;
				case BS_CHECK_ERROR:
					CLog::Info(KERNEL, "FATAL: BugSlayer integrity FAILED! See bugslayer.log for "
							"detailed information.");
					break;

			}
		}

		virtual bool Load() {
			return true;
		}
		virtual bool Unload() {
			return true;
		}
		virtual void HandleEvents() {
			if (time(NULL) - last_checkpoint_ >= CHECK_PERIOD) {
				Checkpoint(false);
			}
		}
		virtual bool OnShowStatus(String &output)
		{
			char temp[80];
			String interval;

			interval = ConvertInterval2String( time(NULL) - last_checkpoint_);
			sprintf(temp, SHOW_INTERFACE_INDENT "Last checkpoint: %s ago\n", 
					interval.c_str());
			output += temp;
			return true;
		}

	private:
		time_t last_checkpoint_;
		static Kernel_BugSlayer_Checker *instance_;
};

Kernel_BugSlayer_Checker *Kernel_BugSlayer_Checker::instance_;

#endif

//-----------------------------------------------------------------------------
// Singleton manipulation
//
Kernel * Kernel::Create()
{
	//assert(kernelInstance == NULL);
	if (kernelInstance == NULL)
		kernelInstance = new Kernel;
	return kernelInstance;
}

void Kernel::Destroy()
{
	delete kernelInstance;
	kernelInstance = NULL;
}

//-----------------------------------------------------------------------------
// Constructor
//
Kernel::Kernel()
{
	m_State = KS_DEAD;
	m_InitLevel = LVL_NULL;
	m_MaintenanceInitInterval = 10;
	m_RestartAfterMaintenance = true;
	m_MaxWaitMaintenance = 30;

	m_CurrentTask = NULL;
	m_MaxTask = 12500;
	//Linux Porting
	//m_BaseDir = "C:/Switchlab/";
	//m_BaseDir = "/etc/xgate/";
	m_BaseDir = BASE_DIR;

	m_RootConfigTree = NULL;
	m_SystemConfigTree = NULL;
	m_Version = Xgate_Version;
	m_SleepTime = 1;
	kernelBusyTime.set(0, 0);

	//Linux Porting
	//m_SystemLock = NULL; 
	/* Initialize pthread condition variable */
	pthread_cond_init(&m_Pcondevent,NULL);

	/* Initialize mutext as a recursive type */
	pthread_mutexattr_init(&m_Pattr);
	pthread_mutexattr_settype(&m_Pattr, PTHREAD_MUTEX_RECURSIVE);
	pthread_mutex_init(&m_SystemLock,&m_Pattr);

	/* Convert from timeval to timespec */
	m_Mutexts.tv_sec  = 0;
	m_Mutexts.tv_nsec = 1000;

	m_MainThreadId = -1;
	m_BoostSystemLockOwner = THREAD_PRIORITY_ABOVE_NORMAL;

#ifdef KERNEL_RECORD_ACQUIRE_LOCK
	m_LongestLockSrcFile = m_CurrentLockSrcFile = "";
	//m_LongestLockSrcLine = m_CurrentLockSrcLine = 0;
	m_SystemLockTimer.init();
	currentService = "";
	m_SystemLockOwner = NULL;
	m_SystemLockPriority = THREAD_PRIORITY_ERROR_RETURN;
#endif

	m_KernelInfo = new CKernelInfo;

	for (int i=0; i<MAX_TLS+2; ++i) {
		m_TLS.push_back(0);
		m_TLS[i] = 0;
	}

	// Get SBH settings.
	//Linux Porting
	/*m_SbhDefaultThreshold = _get_sbh_threshold(); */
	m_SbhThreshold = -1;

	// Load new configuration
	m_RootConfigTree = new Cfg_Tree_Group ("root", "Root configuration", NULL);

	//	InitializeCriticalSection(&crit_sect_general);
}


//-----------------------------------------------------------------------------
// Destructor
//
Kernel::~Kernel()
{
	delete m_RootConfigTree;
	delete m_KernelInfo;
	m_KernelInfo = NULL;
	m_RootConfigTree = NULL;
	//	DeleteCriticalSection(&crit_sect_general);
}


int Kernel::AllocTLS()
{
	for (int i=0; i<MAX_TLS; ++i)
		if (m_TLS[i]==0) {
			m_TLS[i] = 1;
			return i;
		}
	assert(false);
	CLog::Fatal (KERNEL, "Kernel is running out of TLS");
	return MAX_TLS+1;
}


STATUS Kernel::FreeTLS(int i)
{
	m_TLS[i] = 0;
	return OK;
}


#ifdef KERNEL_RECORD_ACQUIRE_LOCK
bool Kernel::AcquireSystemLock(const char *file, unsigned linenum) 
{
	//
	// Must not hold the lock before.
	// In the future, system lock might be changed to use non-recursive
	// mutex for better performance.
	//
	DWORD status;
	status=pthread_mutex_lock(&m_SystemLock);
#ifndef __linux__
#ifndef DEBUG_AW
	//assert (ACE_Thread::self() != m_SystemLockOwner);
#endif
	DWORD status;

	//Linux Porting
	//if ((status=::WaitForSingleObject(m_SystemLock, 0)) == WAIT_TIMEOUT)
	unsigned i;
	enum {
		MAX_WAIT_COUNT = 10
	};
	for (i=0; i<MAX_WAIT_COUNT; ++i) {
		/* if ((status=pthread_cond_timedwait(&m_Pcondevent, &m_SystemLock, SYSLOCK_TIMEOUT)) != ETIMEDOUT)
		*/
		//status=pthread_mutex_lock(&m_SystemLock);
		break;
		/* Linux Porting
		*/
	}
	if (i==MAX_WAIT_COUNT) {
		/* Linux Porting
		*/
		// Must return here
		return false;
	}

	//m_SystemLockOwner = ACE_Thread::self();
	m_SystemLockOwner =  pthread_self();
	if (m_SystemLockOwner != GetMainThreadId() && m_BoostSystemLockOwner!=THREAD_PRIORITY_ERROR_RETURN) {
		//HANDLE current_thread = ::GetCurrentThread();
		pthread_t current_thread = pthread_self(); 
		//assert (current_thread != NULL);
		struct sched_param params;
		pthread_attr_t attr;
		int s,policy=0,ret;
		ret = pthread_getschedparam(current_thread, &policy, &params); 
		if (ret != 0) {
			//Log the data
		}
		ret = pthread_setschedparam(current_thread, SCHED_FIFO, &params); 
		m_SystemLockPriority = pthread_getschedparam(current_thread, &policy, &params);

		//Set the Priority
		//m_SystemLockPriority = GetThreadPriority(current_thread);
		//::SetThreadPriority(current_thread, m_BoostSystemLockOwner);

	}

	//Linux Porting
	//atomic_set ((long*)&m_CurrentLockSrcFile, (long)file);
	//atomic_set (&m_CurrentLockSrcLine, linenum);
	m_SystemLockTimer.start();
#endif
	return true;
}

void Kernel::ReleaseSystemLock(const char *file, unsigned linenum) 
{
	//
	// Must hold the lock before.
	//
#ifndef __linux__
#ifndef DO_DEBUGGING
	//assert (ACE_Thread::self() == m_SystemLockOwner);
	assert (pthread_self() == m_SystemLockOwner);
#endif


	//
	// Update lock time statistics.
	//
	m_SystemLockTimer.stop();
	Time_Value how_long = m_SystemLockTimer.get_elapsed();
	if (how_long > m_LongestLockTime) {
		m_LongestLockTime = how_long;
	}



	// Release the lock.
	/*
	   while (::ReleaseMutex (m_SystemLock))
	   ;
	   */
	//if (ACE_Thread::self() == m_SystemLockOwner)
	if ( pthread_self() ==  m_SystemLockOwner) {
		/* Put back the original thread priority, only if it was previously set.
		*/
		if ( pthread_self() != GetMainThreadId() && m_SystemLockPriority!=THREAD_PRIORITY_ERROR_RETURN) {
			//::SetThreadPriority(::GetCurrentThread(), m_SystemLockPriority);
			struct sched_param params;
			pthread_attr_t attr;
			int s,policy=0,ret;
			ret = pthread_getschedparam(pthread_self(), &policy, &params);
			if (ret != 0) {
				//Log the data
			}
			ret = pthread_setschedparam(pthread_self(), &m_SystemLockPriority, &params);
			m_SystemLockPriority = pthread_getschedparam(pthread_self(), &policy, &params);

			m_SystemLockPriority = THREAD_PRIORITY_ERROR_RETURN;
		}
		m_SystemLockOwner = NULL;
	}
#endif
	//Linux Porting
	//::ReleaseMutex (m_SystemLock);
	pthread_mutex_unlock (&m_SystemLock);
}

#endif

//-----------------------------------------------------------------------------
// Statistics update. Called with parameter 0 after a creation of a new task,
// and called with parameter non zero before killing the task
//
void Kernel::UpdateStat(CTask *task)
{
	if (m_KernelInfo->m_NConcurrentTask > m_KernelInfo->m_HighTask) {
		m_KernelInfo->m_HighTask = m_KernelInfo->m_NConcurrentTask;
		time(&m_KernelInfo->m_HighTaskAt);
	}

	if (task==0) {
		return;
	}

	++m_KernelInfo->m_TotalTask;

	const CTaskInfo *t = task->GetTaskInfo();

	// Must be incremented here (div by zero problem)
	++m_KernelInfo->m_TotalTaskInAvg;

	// Calculate average task waiting
	double total_wait = m_KernelInfo->m_MSAvgTaskWaiting;
	total_wait *= (m_KernelInfo->m_TotalTaskInAvg-1);
	total_wait += t->m_MSLongWaiting;
	m_KernelInfo->m_MSAvgTaskWaiting = total_wait / m_KernelInfo->m_TotalTaskInAvg;

	// Calculate average task longest execution
	double total_longest = m_KernelInfo->m_MSAvgTaskLongestExec;
	total_longest *= (m_KernelInfo->m_TotalTaskInAvg-1);
	total_longest += t->m_MSLongExec;
	m_KernelInfo->m_MSAvgTaskLongestExec = total_longest / m_KernelInfo->m_TotalTaskInAvg;

	// Calculate average tasks total execution
	double total_total = m_KernelInfo->m_MSAvgTaskTotalExec;
	total_total *= (m_KernelInfo->m_TotalTaskInAvg-1);
	total_total += t->m_MSExecTime;
	m_KernelInfo->m_MSAvgTaskTotalExec = total_total / m_KernelInfo->m_TotalTaskInAvg;

	// If the number of total tasks in average grows very large,
	// truncate it.
	enum {
		MAX_TOTAL_TASK_IN_AVG = 2000000,
		SET_TOTAL_TASK_IN_AVG = 1000000
	};
	if (m_KernelInfo->m_TotalTaskInAvg > MAX_TOTAL_TASK_IN_AVG)
		m_KernelInfo->m_TotalTaskInAvg = SET_TOTAL_TASK_IN_AVG;


	if (t->m_Uptime > m_KernelInfo->m_MSLongTaskUp/1000) {
		m_KernelInfo->m_MSLongTaskUp = t->m_Uptime*1000;
		strncpy( m_KernelInfo->m_LongTaskUpName, t->m_Name, sizeof(m_KernelInfo->m_LongTaskUpName)-1);
	}

	if (t->m_MSExecTime > m_KernelInfo->m_MSLongTaskTotalExec) {
		m_KernelInfo->m_MSLongTaskTotalExec = t->m_MSExecTime;
		strncpy( m_KernelInfo->m_LongTaskTotalExecName, t->m_Name, sizeof(m_KernelInfo->m_LongTaskUpName)-1);
	}

	if (t->m_MSLongExec > m_KernelInfo->m_MSLongTaskExec) {
		m_KernelInfo->m_MSLongTaskExec = t->m_MSLongExec;
		strncpy( m_KernelInfo->m_LongTaskExecName, t->m_Name, sizeof(m_KernelInfo->m_LongTaskExecName)-1);
	}

	if (t->m_MSLongBlocked > m_KernelInfo->m_MSLongTaskBlocked) {
		m_KernelInfo->m_MSLongTaskBlocked = t->m_MSLongBlocked;
		strncpy( m_KernelInfo->m_LongTaskBlockedName, t->m_Name, sizeof(m_KernelInfo->m_LongTaskBlockedName)-1);
	}

	if (t->m_MSLongWaiting > m_KernelInfo->m_MSLongTaskWaiting) {
		m_KernelInfo->m_MSLongTaskWaiting = t->m_MSLongWaiting;
		strncpy( m_KernelInfo->m_LongTaskWaitingName, t->m_Name, sizeof(m_KernelInfo->m_LongTaskWaitingName)-1);
		time(&m_KernelInfo->m_LongTaskWaitingAt);
	}
}


//-----------------------------------------------------------------------------
// Tools function to save configuration to a file.
// (This should belong to Kernel class actually, but I don't want to change
//  kernel.h)
//
void SaveConfig(Cfg_Tree_Group *config, const char *filename)
{
	Term_Cfg_Writer writer ( config, false);
	//printf("file name =%s\n",filename);
	//printf("Getresul =%s\n",writer.GetResult().c_str());
	FILE *fhnd = fopen(filename, "rw");
	if (fhnd) {
		fwrite(writer.GetResult().c_str(), writer.GetResult().size(), 1, fhnd);
		fclose(fhnd);
	}
}


//-----------------------------------------------------------------------------
void Kernel::InitConfig()
{
	//
	// Create kernel commands
	//
	// Add system command
	Term_Cmd *cmd_shutdown = new Term_Cmd (this,
			Kernel_Term_Cmd_System_Cmd,
			"system",
			"System commands",
			PrivilegeLevelAdmin,
			TermModeNormal,
			false);
	CVariantChoiceValidator sysVdtor("shutdown", "Shutdown the system");
	sysVdtor.Add ("restart", "Restart the system");
	sysVdtor.Add ("raise", "Raise EX_HANGUP exception for all tasks" );
#ifdef XGATE_HAS_BUGSLAYER
	sysVdtor.Add ("bug-check", "Perform BugSlayer integrity checking" );
#endif
	cmd_shutdown->Add ( new Term_Cmd_Arg("cmd", CVariant(""), sysVdtor) );

	CVariantChoiceValidator shVdtor ("hangup", "Raise exceptions for all tasks, and shutdown the system");
	shVdtor.Add ( "abort", "Force the system to shutdown immediately" );
	shVdtor.Add ( "cancel", "Cancel shutdown in progress" );

	cmd_shutdown->AddDynamic ( 1, 0, "shutdown", new Term_Cmd_Arg ("@1", CVariant(""), shVdtor, TermArgOptional) );
	cmd_shutdown->AddDynamic ( 1, 0, "restart", new Term_Cmd_Arg ("@1", CVariant(""), shVdtor, TermArgOptional) );

	cmd_shutdown->AddDynamic ( 1, 0, "raise", new Term_Cmd_Arg ("@1", 
				CVariant(""), 
				CVariantValidator("", "PID number or 'all' for all tasks")));

	RegisterTermCmd (cmd_shutdown, RootConfig());

	// Add command 'spawntask <appname> [cmdline_param1] [cmdline_param2] ...'
	Term_Cmd *cmd_spawntask = new Term_Cmd (this,
			Kernel_Term_Cmd_SpawnTask,
			"spawntask",
			"Create a new task",
			PrivilegeLevelUser,
			TermModeNormal,
