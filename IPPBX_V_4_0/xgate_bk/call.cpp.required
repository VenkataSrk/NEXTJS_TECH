/** Change the current call state to another state
 */
void Call::SetState(CallState state)
{
    if (_state != state) {
	//***CLog::Detail(THISMODULE,"Call %s set to %s",GetName(),StrCallState(state));
	_state = state;
    }
}

/** Return the current call state
 */
CallState Call::GetState()
{
    return _state;
}

