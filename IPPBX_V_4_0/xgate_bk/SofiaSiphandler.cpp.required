void SofiaSiphandler::SetSdpMediaIP_Port(sdp_session_t &dup,xGateSofiaobj *sobj){
  sdp_session_t *rsdp = &dup;
  rsdp->sdp_media->m_port = sobj->port;
  if(rsdp->sdp_connection && rsdp->sdp_connection->c_address)
    rsdp->sdp_connection->c_address = sobj->ipaddr.c_str();
  else if(rsdp->sdp_media)
    rsdp->sdp_media->m_proto_name =  "RTP/AVP";
  //	rsdp->sdp_media->m_rtpmaps = NULL;
  if(rsdp->sdp_media->m_connections)
    if(rsdp->sdp_media->m_connections->c_address)
      rsdp->sdp_media->m_connections->c_address =  sobj->ipaddr.c_str();
    else{
      rsdp->sdp_media->m_connections->c_address = new char[sobj->ipaddr.length()];
      rsdp->sdp_media->m_connections->c_address = sobj->ipaddr.c_str();
    }
  /*rsdp->sdp_media->m_format  = 0;
    rsdp->sdp_media->m_format = new (sdp_list_t);
    rsdp->sdp_media->m_format->l_size = sizeof (sdp_list_t);
    rsdp->sdp_media->m_format->l_text = "111";
    rsdp->sdp_media->m_format->l_next = NULL;
    AppendSdpAttribute(*rsdp,"rtpmap","111 OPUS/48000/2",1);*/
}
/*
*/
void SofiaSiphandler::AppendSdpAttribute(sdp_session_t &dup,const char* name, const char* value,int type){
  sdp_session_t *rsdp = &dup;
  sdp_attribute_t *rtpatt = new sdp_attribute_t;
  rtpatt->a_next = NULL;
  rtpatt->a_name = name;
  rtpatt->a_value = value;
  rtpatt->a_size = sizeof (sdp_attribute_t);
  if(type == 0)
    sdp_attribute_append(&rsdp->sdp_media->m_session->sdp_attributes,rtpatt);
  else
    sdp_attribute_append(&rsdp->sdp_media->m_attributes,rtpatt);
}
void SofiaSiphandler::AppendSdpMediaFormat(sdp_list_t  &dup, const char*value,int type){

  sdp_list_t *mline =  &dup;
  cout << "Format Value " << value << endl;
  if(mline)
  {
    mline->l_next =  new sdp_list_t;
    mline =  mline->l_next;
  }
  else{
    mline =  new sdp_list_t;
  }
  // rsdp->sdp_media->m_format =  new sdp_list;
  mline->l_text = "111";
  mline->l_next = NULL;
  mline->l_size = sizeof (sdp_list_t);
}
void SofiaSiphandler::CreateSdpOpus(sdp_session_t &dup,xGateSofiaobj *sobj){
  sdp_session_t *rsdp =  &dup;
  sdp_attribute_t *group=NULL;

  char *grouplbl = NULL;
  char *wmslabel = NULL;
  char *msidlbl = NULL;
  char *fngprint = NULL;
  char *ssrccname = NULL;
  char *ssrcmsid = NULL;
  char *ssrcmslabel = NULL;
  char *ssrclabel = NULL;

  grouplbl = new char[300]; memset(grouplbl,'\0',300);
  wmslabel = new char[300]; memset(wmslabel,'\0',300);
  msidlbl = new char[300]; memset(msidlbl,'\0',300);
  fngprint = new char[300]; memset(fngprint,'\0',300);
  ssrccname = new char[300]; memset(ssrccname,'\0',300);
  ssrcmsid = new char[300]; memset(ssrcmsid,'\0',300);
  ssrcmslabel = new char[300]; memset(ssrcmslabel,'\0',300);
  ssrclabel = new char[300]; memset(ssrclabel,'\0',300);

  rsdp->sdp_media->m_attributes = NULL;
  if(rsdp->sdp_media->m_rtpmaps)
    rsdp->sdp_media->m_rtpmaps = NULL;
  rsdp->sdp_media->m_proto = sdp_proto_x;
  rsdp->sdp_media->m_proto_name =  "UDP/TLS/RTP/SAVPF";
  rsdp->sdp_media->m_session->sdp_subject  = "talk";
  rsdp->sdp_media->m_attributes = NULL;
  rsdp->sdp_media->m_attributes = new (sdp_attribute_t);
  rsdp->sdp_media->m_attributes->a_name = "sendrecv";
  rsdp->sdp_media->m_attributes->a_size = sizeof (sdp_attribute_t);
  rsdp->sdp_media->m_attributes->a_value = NULL;
  rsdp->sdp_media->m_attributes->a_next = NULL;
  rsdp->sdp_media->m_format  = 0;
  rsdp->sdp_media->m_format = new (sdp_list_t);
  rsdp->sdp_media->m_format->l_size = sizeof (sdp_list_t);
  rsdp->sdp_media->m_format->l_text = "111";
  rsdp->sdp_media->m_format->l_next = NULL;
  /*rsdp->sdp_media->m_format->l_next = new (sdp_list_t);
    rsdp->sdp_media->m_format->l_next->l_size =  sizeof (sdp_list_t);
    rsdp->sdp_media->m_format->l_next->l_text = "101";
    rsdp->sdp_media->m_format->l_next->l_next = NULL;*/

  char *value =  new char[50];memset(value,'\0',50);
  sprintf(value,"1 1 udp %u %s %d typ relay ",(rand()&0xFFFFFFFF),sobj->ipaddr.c_str(),sobj->port);
  AppendSdpAttribute(*rsdp,"candidate",value,1);
//  if(sobj->cp.csCallAgenttype == 2 || strstr(sobj->cp.calledDeviceType.c_str(),"URWEB") || strstr(sobj->SofiaLegB->cp.calledDeviceType.c_str(),"URWEB")|| strstr(sobj->cp.calledDeviceType.c_str(),"URAPP")){

if(sobj->callstream == EN_INBOUND){
    sdp_attribute_remove(&rsdp->sdp_media->m_session->sdp_attributes, "group");
    if (strstr(sobj->cp.calledDeviceType.c_str(),"URAPP")) {
      AppendSdpAttribute(*rsdp,"group","BUNDLE audio", 0);
    } else {
      AppendSdpAttribute(*rsdp,"group","BUNDLE 0", 0);
    }

    sdp_attribute_remove(&rsdp->sdp_media->m_session->sdp_attributes, "msid-semantic");
// sdp_attribute_remove(&rsdp->sdp_media->m_session->sdp_attributes, "");
    sprintf(wmslabel, "WMS %s", sobj->SofiaSDPinfo.mslabel.c_str());
    AppendSdpAttribute(*rsdp,"msid-semantic", wmslabel, 0);

    AppendSdpAttribute(*rsdp,"ice-ufrag",sobj->SofiaSDPinfo.iceufrag.c_str(),1);
    AppendSdpAttribute(*rsdp,"ice-pwd",sobj->SofiaSDPinfo.icepwd.c_str(),1);
    AppendSdpAttribute(*rsdp,"ice-options","trickle",1);
    sprintf(fngprint,"sha-256 %s",sobj->SofiaSDPinfo.fingerprint.c_str());
    AppendSdpAttribute(*rsdp,"fingerprint", fngprint,1);

    sdp_attribute_remove(&rsdp->sdp_media->m_session->sdp_attributes, "setup");
    if(sobj->callstate < CS_Connected) // This done for Hold Resume for APP cases
    AppendSdpAttribute(*rsdp,"setup","actpass",1);
    else
     AppendSdpAttribute(*rsdp,"setup","passive",1);

    sdp_attribute_remove(&rsdp->sdp_media->m_session->sdp_attributes, "mid");
    if (strstr(sobj->cp.calledDeviceType.c_str(),"URAPP")) {
      AppendSdpAttribute(*rsdp,"mid","audio",1);
    }else {
      AppendSdpAttribute(*rsdp,"mid","0",1);
    }

    //AppendSdpAttribute(*rsdp,"extmap","1 urn:ietf:params:rtp-hdrext:hdrext:ssrc-audio-level",1);

    AppendSdpAttribute(*rsdp,"rtcp-mux",NULL,1);
    AppendSdpAttribute(*rsdp,"rtpmap","111 OPUS/48000/2",1);
    AppendSdpAttribute(*rsdp,"fmtp", "111 minptime=10;useinbandfec=1", 1);
    AppendSdpAttribute(*rsdp,"rtpmap","101 telephone-event/8000",1);

    sprintf(ssrccname,"%s cname:%s",sobj->SofiaSDPinfo.ssrc.c_str(),sobj->SofiaSDPinfo.cname.c_str());
    AppendSdpAttribute(*rsdp, "ssrc", ssrccname ,1);

    sprintf(ssrcmsid,"%s msid:%s %s", sobj->SofiaSDPinfo.ssrc.c_str(), sobj->SofiaSDPinfo.mslabel.c_str(), sobj->SofiaSDPinfo.label.c_str());
    AppendSdpAttribute(*rsdp, "ssrc", ssrcmsid, 1);

    sprintf(ssrcmslabel,"%s mslabel:%s", sobj->SofiaSDPinfo.ssrc.c_str(), sobj->SofiaSDPinfo.mslabel.c_str());
    AppendSdpAttribute(*rsdp, "ssrc", ssrcmslabel, 1);

    sprintf(ssrclabel,"%s label:%s", sobj->SofiaSDPinfo.ssrc.c_str(), sobj->SofiaSDPinfo.label.c_str());
    AppendSdpAttribute(*rsdp, "ssrc", ssrclabel, 1);
  }
  else{

    sdp_attribute_remove(&rsdp->sdp_media->m_session->sdp_attributes, "msid-semantic");
    sprintf(wmslabel, "WMS %s", sobj->SofiaLegB->SofiaSDPinfo.mslabel.c_str());   
    AppendSdpAttribute(*rsdp,"msid-semantic", wmslabel, 0);

    AppendSdpAttribute(*rsdp,"ice-ufrag",sobj->SofiaLegB->SofiaSDPinfo.iceufrag.c_str(),1);
    AppendSdpAttribute(*rsdp,"ice-pwd",sobj->SofiaLegB->SofiaSDPinfo.icepwd.c_str(),1);
    AppendSdpAttribute(*rsdp,"ice-options","trickle",1);
    sprintf(fngprint,"sha-256 %s",sobj->SofiaLegB->SofiaSDPinfo.fingerprint.c_str());
    AppendSdpAttribute(*rsdp,"fingerprint", fngprint,1);

    sdp_attribute_remove(&rsdp->sdp_media->m_session->sdp_attributes, "setup");
    AppendSdpAttribute(*rsdp,"setup","passive",1);
    //AppendSdpAttribute(*rsdp,"setup","active",1);

    //AppendSdpAttribute(*rsdp,"mid","audio",1);
    //  AppendSdpAttribute(*rsdp,"mid","0",1);

    AppendSdpAttribute(*rsdp,"rtcp-mux",NULL,1);
    AppendSdpAttribute(*rsdp,"rtpmap","111 OPUS/48000/2",1);
    AppendSdpAttribute(*rsdp,"fmtp", "111 minptime=10;useinbandfec=1", 1);
    AppendSdpAttribute(*rsdp,"rtpmap","101 telephone-event/8000",1);

    sprintf(ssrccname,"%s cname:%s",sobj->SofiaLegB->SofiaSDPinfo.ssrc.c_str(),sobj->SofiaLegB->SofiaSDPinfo.cname.c_str());
    AppendSdpAttribute(*rsdp, "ssrc", ssrccname ,1);

    sprintf(ssrcmsid,"%s msid:%s %s", sobj->SofiaLegB->SofiaSDPinfo.ssrc.c_str(), sobj->SofiaLegB->SofiaSDPinfo.mslabel.c_str(), sobj->SofiaLegB->SofiaSDPinfo.label.c_str());
    //sprintf(ssrcmsid,"%s msid:%s %s", sobj->SofiaLegB->SofiaSDPinfo.ssrc.c_str(),"ARDAMS","ARDAMSa0");
    AppendSdpAttribute(*rsdp, "ssrc", ssrcmsid, 1);

    sprintf(ssrcmslabel,"%s mslabel:%s", sobj->SofiaLegB->SofiaSDPinfo.ssrc.c_str(), sobj->SofiaLegB->SofiaSDPinfo.mslabel.c_str());
    //sprintf(ssrcmslabel,"%s mslabel:%s", sobj->SofiaLegB->SofiaSDPinfo.ssrc.c_str(), "ARDAMS");
    AppendSdpAttribute(*rsdp, "ssrc", ssrcmslabel, 1);

    sprintf(ssrclabel,"%s label:%s", sobj->SofiaLegB->SofiaSDPinfo.ssrc.c_str(), sobj->SofiaLegB->SofiaSDPinfo.label.c_str());
    //sprintf(ssrclabel,"%s label:%s", sobj->SofiaLegB->SofiaSDPinfo.ssrc.c_str(), "ARDAMSa0");
    AppendSdpAttribute(*rsdp, "ssrc", ssrclabel, 1);
    //AppendSdpAttribute(*rsdp,"extmap","1 urn:ietf:params:rtp-hdrext:hdrext:ssrc-audio-level",1);
    //   AppendSdpAttribute(*rsdp,"extmap","2 urn:ietf:params:rtp-hdrext:sdes:mid",1);
  }
  std::string vmsid = "0 0";
  //vmsid += " ";
  //vmsid += "-"; 
  //AppendSdpAttribute(*rsdp,"msid",vmsid.c_str(),1);
}
void SofiaSiphandler::CreateSdpGCodec(sdp_session_t &dup,xGateSofiaobj *sobj)
{
  sdp_session_t *rsdp =  &dup;
  rsdp->sdp_media->m_proto_name = "RTP/AVP";
  if(rsdp->sdp_media->m_session && rsdp->sdp_media->m_session->sdp_attributes){
    rsdp->sdp_media->m_session->sdp_attributes = NULL;
  }
  rsdp->sdp_media->m_attributes = NULL; // TODO just for checking yadav rework to have common sdp valuesi
  /*  if(sobj->cp.csCalledCodec == 18)
      AppendSdpAttribute(*rsdp,"ptime","10",1);
      else
      AppendSdpAttribute(*rsdp,"ptime","20",1);*/
  rsdp->sdp_media->m_session->sdp_subject  = "SDP Session";	
  cout << "Calling Code Type " << sobj->cp.csCalledCodec << endl;
  for(int index= 0 ; index < MAXCODEC ; index++){

    if(sobj->cp.csCalledCodec == xGateCodecList[index].payload){
      if(rsdp->sdp_media->m_rtpmaps == NULL)
        rsdp->sdp_media->m_rtpmaps = new sdp_rtpmap_t;
      rsdp->sdp_media->m_rtpmaps->rm_pt = xGateCodecList[index].payload;
      rsdp->sdp_media->m_rtpmaps->rm_encoding = xGateCodecList[index].codecname;
      rsdp->sdp_media->m_rtpmaps->rm_rate = xGateCodecList[index].samplingrate;
      rsdp->sdp_media->m_rtpmaps->rm_fmtp = xGateCodecList[index].fmtp;
      rsdp->sdp_media->m_rtpmaps->rm_size = sizeof ( sdp_rtpmap_t);
      rsdp->sdp_media->m_rtpmaps->rm_params = NULL;
      rsdp->sdp_media->m_rtpmaps->rm_next = NULL;
      break;
    }
  }
}
sdp_session_t* SofiaSiphandler::EncodeDialSDP(xGateSofiaobj *sobj, int payloadtype){
  sdp_session_t *rsdp = sdp_session_dup(&m_homeMemory,(sdp_session_t*)sobj->rsdp);
  if(rsdp) {
    SetSdpMediaIP_Port(*rsdp,sobj); // Set  the Media Port and IP form MG
    cout << "Dial PayLoad Type" << payloadtype << endl;;
    switch(payloadtype){
      case 8:
      case 18:
        CreateSdpGCodec(*rsdp,sobj);
        break;
      case 111:
      case 51:
        CreateSdpOpus(*rsdp,sobj);
        break;
      default:
        break;
    }

    return rsdp;
  }	
  else return NULL;

}
std::string SofiaSiphandler::EncodeDialStringSDP(xGateSofiaobj *sobj){
std::stringstream SDPStr;
SDPStr<<"s=SDP session\r\n";
SDPStr<<"c=IN IP4 "<<sobj->ipaddr<<"\r\n" ;

if(sobj->cp.csCalledCodec == 8){
SDPStr<<"m=audio "<<sobj->port<<" RTP/AVP ";
SDPStr<< sobj->cp.csCalledCodec<<" " <<"\r\n";
SDPStr<<"a=rtpmap:"<<8<<" "<<"PCMA/8000\r\n";
SDPStr<<"a=ptime:20"<<"\r\n";
}
else if(sobj->cp.csCalledCodec == 111){
if(strstr(sobj->cp.calledDeviceType.c_str(),"URAPP")){
SDPStr<<"a=group:BUNDLE audio"<<"\r\n";
SDPStr<<"a=mid:audio"<<"\r\n";
}else {
SDPStr<<"a=group:BUNDLE 0"<<"\r\n";
SDPStr<<"a=mid:0"<<"\r\n";
}
SDPStr<<"a=msid-semantic:WMS " <<sobj->SofiaSDPinfo.mslabel<<"\r\n";
SDPStr<<"m=audio "<<sobj->port<<" UDP/TLS/RTP/SAVPF ";
SDPStr<< sobj->cp.csCalledCodec<<" " <<"\r\n";
SDPStr<<"a=candidate:1 1 udp "<<(rand()&0xFFFFFFFF)<<" "<<sobj->ipaddr<<" " <<sobj->port<<" relay"<<"\r\n";
SDPStr<<"a=ice-ufrag:"<<sobj->SofiaSDPinfo.iceufrag<<"\r\n";
SDPStr<<"a=ice-pwd:"<<sobj->SofiaSDPinfo.icepwd<<"\r\n";
SDPStr<<"a=ice-option:trickle"<<"\r\n";
SDPStr<<"a=fingerprint:sha-256 " << sobj->SofiaSDPinfo.fingerprint <<"\r\n";
SDPStr<<"a=setup:actpass"<<"\r\n";
SDPStr<<"a=rtpmap:"<<sobj->cp.csCalledCodec<<" "<<"OPUS/48000/2\r\n";
SDPStr<<"a=fmtp:"<<sobj->cp.csCalledCodec<<" minptime=10;useinbandfec=1"<<"\r\n";
SDPStr<<"a=ssrc:"<<sobj->SofiaSDPinfo.ssrc<<"cname:"<<sobj->SofiaSDPinfo.cname<<"\r\n";
SDPStr<<"a=ssrc:"<<sobj->SofiaSDPinfo.ssrc<<"msid:"<<sobj->SofiaSDPinfo.mslabel<<" "<<sobj->SofiaSDPinfo.label<<"\r\n";
SDPStr<<"a=ssrc:"<<sobj->SofiaSDPinfo.ssrc<<"mslable:"<<sobj->SofiaSDPinfo.mslabel<<"\r\n";
SDPStr<<"a=ssrc:"<<sobj->SofiaSDPinfo.ssrc<<"lable:"<<sobj->SofiaSDPinfo.label<<"\r\n";
SDPStr<<"a=ptime:30"<<"\r\n";
}
return SDPStr.str();
}
sdp_session_t* SofiaSiphandler::EncodeResponseSDP(xGateSofiaobj *sobj){
  sdp_session_t *rsdp = sdp_session_dup(&m_homeMemory,(sdp_session_t*)sobj->SofiaLegB->rsdp);
  if(rsdp){
    SetSdpMediaIP_Port(*rsdp,sobj); // Set  the Media Port and IP form MG

    switch(rsdp->sdp_media->m_proto){
      case sdp_proto_x:
      case sdp_proto_srtp:
        sobj->cp.csCalledCodec = 111;
        CreateSdpOpus(*rsdp,sobj);
        break;	
      default :
	sobj->cp.csCalledCodec = 8;// TODO this hard codd due repsonse error
        CreateSdpGCodec(*rsdp,sobj);                
        break;
    }
    return rsdp;
  }else return NULL;
}
bool SofiaSiphandler::CreateLocalSdpParam(xGateSofiaobj *sobj, nua_handle_t* nhandle){
  sdp_session_t *lsdp = NULL;
//#define nhandle ((nua_handle_t*)sobj->SofiaLegB->sofianh)
if(!nhandle)
 nhandle = (nua_handle_t*)sobj->SofiaLegB->sofianh;
 
  if(!sobj)
  {
    CLog::Error(THISMODULE,"SofiaSiphandler::CreateLocalSdpParam Invalid sobj");
    return false;
  }

  sdp_session_t *rsdp; //= (sdp_session_t*)sobj->rsdp;
  if(sobj->P2PMedia){
    switch(sobj->callstream){
      case EN_OUTBOUND:
        rsdp = (sdp_session_t*)sobj->rsdp;

        //SetSDPAnswer(*rsdp,"setup") ;
        CLog::Info(THISMODULE,"SofiaSiphandler::CreateLocalSdpParam P2PMedia LEG B Enabled call id%s",sobj->callid.c_str());

        break;
      case EN_INBOUND:
        rsdp = (sdp_session_t*)sobj->rsdp;
        CLog::Info(THISMODULE,"SofiaSiphandler::CreateLocalSdpParam P2PMedia Enabled call id%s",sobj->callid.c_str());
        break;
    }
  }else {

    if(sobj->port <= 0)
    {
      CLog::Error(THISMODULE,"SofiaSiphandler::CreateLocalSdpParam Invalid Media Port ");
      return false;
    }
    switch(sobj->callstream){
      case EN_OUTBOUND: // Responce to Leg A Peer
        {
          CLog::Error(THISMODULE,"Response to  peer CallStream is EN_OUTBOUND %s",sobj->callid.c_str());
          rsdp = EncodeResponseSDP(sobj);
          CLog::Error(THISMODULE,"SofiaSiphandler::CreateLocalSdpParam DTLS candidate ufrag %s pwd %s fringerprint %s",
              sobj->SofiaLegB->SofiaSDPinfo.iceufrag.c_str(),sobj->SofiaLegB->SofiaSDPinfo.icepwd.c_str(),sobj->SofiaLegB->SofiaSDPinfo.fingerprint.c_str());
          CLog::Error(THISMODULE,"SofiaSiphandler::CreateLocalSdpParam SSRC %s CNAME %s MSLABEL %s LABEL %s", sobj->SofiaLegB->SofiaSDPinfo.ssrc.c_str(),
              sobj->SofiaLegB->SofiaSDPinfo.cname.c_str(),sobj->SofiaLegB->SofiaSDPinfo.mslabel.c_str(), sobj->SofiaLegB->SofiaSDPinfo.label.c_str());
        }
        break;
      case EN_INBOUND: // Dial to Leg B Peer
        {
          CLog::Error(THISMODULE," Dialing to  peer CallStream is EN_INBOUND %s",sobj->callid.c_str());
          rsdp = EncodeDialSDP(sobj,sobj->cp.csCalledCodec);
          CLog::Error(THISMODULE,"SofiaSiphandler::CreateLocalSdpParam DTLS candidate ufrag %s pwd %s fringerprint %s",
              sobj->SofiaSDPinfo.iceufrag.c_str(),sobj->SofiaSDPinfo.icepwd.c_str(),sobj->SofiaSDPinfo.fingerprint.c_str());

        }
        break;
      default:
        CLog::Error(THISMODULE,"SofiaSiphandler::CreateLocalSdpParam Invalid Call Stream Type ");
        return false;

    }// Switch case callstream	
  }



  if(rsdp){
/*           sdp_printer_t *printer = 0;
             memset(buf,'/0',4024);
             printer = sdp_print(&m_homeMemory, rsdp, buf, 4024, sdp_f_realloc);
             if(printer){
             cout << " \n dialout SDP " << sdp_message(printer) << endl;
             CLog::Detail(THISMODULE,"SofiaSiphandler:CreateLocalSdpParam(%s)",sdp_message(printer));
             sdp_printer_free(printer);
             }*/
    int Onhold = 0;
    if(sobj->mediastate == EN_MED_SUSPENDED)
      Onhold = 1;

    nua_set_hparams(nhandle,
        SOATAG_AUDIO_AUX("telephone-event"),
        //      TAG_IF(!Onhold, SOATAG_HOLD("")),// force sofia to put "sendrecv"
        //   SOATAG_USER_SDP_STR(sdp_message(printer)),
        TAG_IF(!Onhold,  NUTAG_EARLY_MEDIA (1)),
        TAG_IF(!Onhold,  NUTAG_EARLY_ANSWER(1)),
        SOATAG_USER_SDP(rsdp),
        //     TAG_IF(!Onhold, SOATAG_ACTIVE_AUDIO(SOA_ACTIVE_SENDRECV)),// force sofia to put "sendrecv"
        //    TAG_IF(!Onhold,  SOATAG_ACTIVE_VIDEO(SOA_ACTIVE_SENDRECV)),// force sofia to put "sendrecv"
        TAG_END());

    /*    nua_set_hparams(nhandle,
          SOATAG_AUDIO_AUX("telephone-event"),
          SOATAG_HOLD(""),// force sofia to put "sendrecv"
    //   SOATAG_USER_SDP_STR(sdp_message(printer)),
    NUTAG_EARLY_MEDIA (1),
    NUTAG_EARLY_ANSWER(1),
    SOATAG_USER_SDP(rsdp),
    SOATAG_ACTIVE_AUDIO(SOA_ACTIVE_SENDRECV),// force sofia to put "sendrecv"
    SOATAG_ACTIVE_VIDEO(SOA_ACTIVE_SENDRECV),// force sofia to put "sendrecv"
    TAG_END());*/

  } else{
    CLog::Detail(THISMODULE,"SofiaSiphandler:CreateLocalSdpParam - No SDP Message create");
    return false;
  }

  return true;
}


/* Used to initialize run-time environment including sockets for Sofia Library 
 * Input Param : Void
 */

void SofiaSiphandler::SofiaInit(){
  su_init();
}

/* Used to De - initialize run-time environment including sockets for Sofia Library 
 * Input Param : Void
 */
void SofiaSiphandler::SofiaDeInit(){
  su_deinit();
}

/* Used to initialize applicaton memory for Sofia Library,
 * This helps to start mulitple sofia library using differnt memeory 
 * Input Param : su_home_t structure address
 */
void SofiaSiphandler::SofiaInitMemory(su_home_t &homeMemory ){
  su_home_init(&homeMemory);
}

/* Used to deinitialize applicaton memory for Sofia Library,
 *  Input Param : su_home_t structure address
 */
void SofiaSiphandler::SofiaDeInitMemory(su_home_t &homeMemory){
  su_home_deinit(&homeMemory);
}

/* Used to create root instance
*/
su_root_t *SofiaSiphandler::SofiaInitRoot(su_root_magic_t* appInitance){
  return su_root_create(appInitance);
}

/* Used to destroy root instance
*/
void SofiaSiphandler::SofiaDeInitRoot(su_root_t* nuaRoot){
  su_root_destroy(nuaRoot);
}
/**/
nua_t* SofiaSiphandler::SofiaCreate(su_root_t *root,nua_callback_f 	callback, nua_magic_t *magic){

  /* @NEW_1_12_7. In order to use @b Alert-Info header, initialize the SIP
   * parser before calling nta_agent_create() or nua_create() with, e.g.,
   * sip_update_default_mclass(sip_extend_mclass(NULL)). Sofia -Sip Lib
   */
  sip_update_default_mclass(sip_extend_mclass(NULL));

  m_nuaHandle=  nua_create(root,callback,magic,\
      NUTAG_URL(SIP_URL),\
      // NUTAG_SIPS_URL(SIPS_URL)
      NUTAG_CERTIFICATE_DIR(CERT_PATH),\
      TAG_END());

  SofiaSetParam(m_nuaHandle);
  return m_nuaHandle;

}
/*
 * Create auth mod for authendicating client
 * Still need to chagen the paramater for auth registration
 * */

auth_mod_t* SofiaSiphandler::SofiaInitAuth(su_root_t* root){
  return auth_mod_create(root,AUTHTAG_METHOD("Digest"),AUTHTAG_ALGORITHM("MD5"),AUTHTAG_QOP("auth"),AUTHTAG_REALM("xgatesipreg.vectone.com"),TAG_END());
}
void SofiaSiphandler::SofiaDeInitAuth(auth_mod_t *authmod){
  if(authmod)
    auth_mod_destroy(authmod);
}
