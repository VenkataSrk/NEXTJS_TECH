  // since it is error in Server we need to delete the calli
  /*if(pSipMgc->SofiaLegB && pSipMgc->SofiaLegB->sofianh)
    SofiaSendBye((nua_handle_t*)pSipMgc->SofiaLegB->sofianh);*/

  DeleteCallInfo((pSipMgc));

  return xGateReturn::SUCCESS;
}
bool SofiaSiphandler::CheckResponseRequired(int status, xGateSofiaobj *sobj){
if (!sobj)
 return false;
if(sobj->cp.isForkingenabled){ // Forking Enabled
  return ForkingResponse(status,sobj);
 }

return true;
}
bool SofiaSiphandler::ForkingResponse(int status, xGateSofiaobj *sobj){
CLog::Detail(THISMODULE,"SofiaSiphandler::ForkingResponse Proxy Name %s Callid %s ",sobj->cp.proxyUserName.c_str(), sobj->callid.c_str());
std::vector<xGateSofiaobj*>::iterator itr;
switch(status/100){
case 1:
 if(status ==  180)
   sobj->callstate = CS_Alerting;
else if(status == 183)
  sobj->callstate = CS_Proceeding;
CLog::Detail(THISMODULE,"SofiaSiphandler::ForkingResponse 1XX Proxy Name %s Callid %s ",sobj->cp.proxyUserName.c_str(), sobj->callid.c_str());


return false;

case 2:
{
CLog::Detail(THISMODULE,"SofiaSiphandler::ForkingResponse 2XX Proxy Name %s Callid %s ",sobj->cp.proxyUserName.c_str(), sobj->callid.c_str());
if(sobj->callstream == EN_OUTBOUND){ // Check for Forked B Leg object
// sobj is Forkign Leg
// sobj->SofiaLegB is A Leg (Orginator Leg)
// sobj->SofiaLegB->SofiaLegB is B Leg of A Leg
// Send cancle to other Leg
//std::vector<xGateSofiaobj*>::iterator 
//itr =  sobj->SofiaLegB->SofiaForkLeg.begin();
if(sobj->callstate ==CS_Connected || sobj->callstate == CS_Connecting) // call already connected this is Hold and resume case simple retrun true for forwarding yadav
   return true;
for(itr = sobj->SofiaLegB->SofiaForkLeg.begin(); itr != sobj->SofiaLegB->SofiaForkLeg.end(); itr++) {
xGateSofiaobj* forkSofiaObj = *itr;
if(forkSofiaObj->callstate == CS_Connected) // Already Connect Avaiable
{// So send Bye 
if(sobj != forkSofiaObj){ 
 SofiaSendAck((nua_handle_t*)sobj->sofianh);
 SofiaSendBye((nua_handle_t*)sobj->sofianh);
 DeleteForkedSofiaObject(sobj);
  return false;
}
}
if(sobj == forkSofiaObj)
  continue;
nua_cancel(forkSofiaObj->sofianh,TAG_END());
//sobj->SofiaLegB->SofiaForkLeg.erase(itr);

}
sobj->SofiaLegB->SofiaLegB =  sobj; // Subsuting forking  Leg to A Leg's B Peer  
sobj->SofiaLegB->cp.calledDeviceType = sobj->cp.calledDeviceType;
sobj->SofiaLegB->cp.csCalledCodec = sobj->cp.csCalledCodec;
sobj->callstate = CS_Connected;
}
}
return true;
case 3:

CLog::Detail(THISMODULE,"SofiaSiphandler::ForkingResponse 3XX Proxy Name %s Callid %s ",sobj->cp.proxyUserName.c_str(), sobj->callid.c_str());
return false;
case 4:
CLog::Detail(THISMODULE,"SofiaSiphandler::ForkingResponse 4XX Proxy Name %s Callid %s ",sobj->cp.proxyUserName.c_str(), sobj->callid.c_str());
//std::vector<xGateSofiaobj*>::iterator 
itr =  sobj->SofiaLegB->SofiaForkLeg.begin();
for(itr; itr != sobj->SofiaLegB->SofiaForkLeg.end(); itr++) {
xGateSofiaobj* forkSofiaObj = *itr;
if(sobj == forkSofiaObj){
  sobj->SofiaLegB->SofiaForkLeg.erase(itr);
  break; // for loop
}
}

//cout << "List size: " << sobj->SofiaLegB->SofiaForkLeg.size() << endl;

if(sobj->SofiaLegB->SofiaForkLeg.size() ==  0){
   RespondToPeer(status,sobj->SofiaLegB);
}
DeleteForkedSofiaObject(sobj);

return false;
default:

CLog::Detail(THISMODULE,"SofiaSiphandler::ForkingResponse Default Proxy Name %s Callid %s ",sobj->cp.proxyUserName.c_str(), sobj->callid.c_str());
return false;
}
}
void SofiaSiphandler::RespondToPeer(int status,xGateSofiaobj *sobj){
  if(!sobj){
    CLog::Warning(THISMODULE,"SofiaSiphandler::RespondToPeer Error - Invalid sobj");
    return;
  }
  CLog::Detail(THISMODULE,"SofiaSiphandler::RespondToPeer Event(%d - callid %s) ",(status/100), sobj->callid.c_str());
  sobj->sipeventtype = status;


  switch(status/100){
    case 1:
      RespondWith1xx(sobj);
      break;
    case 2:
      RespondWith2xx(sobj);
      break;
    case 3:
      RespondWith3xx(sobj);
      break;
    case 4:
      RespondWith4xx(sobj);
      break;
    case 5:
      RespondWith5xx(sobj);
      break;
    case 6:
      RespondWith6xx(sobj);
      break;
    default:
      break;
  }
}

bool SofiaSiphandler::DeleteForkedSofiaObject(xGateSofiaobj *sobj){
  if(sobj){
    if(sobj->sofianh){
      SofiaBindhandle(sobj->sofianh, NULL);
      nua_handle_destroy(sobj->sofianh);
    } // Leg A handle clean up This stops the even for Leg A
    printf("****** delated forked LegId: %d\n",sobj->forkedLegId);
    sobj->sofianh = NULL;
    sobj->xGateSofiaobjInit();
    delete sobj;
    sobj = NULL;
  }
  return true;
}

bool SofiaSiphandler::DeleteSofiaObject(xGateSofiaobj *sobj){

  // Check A/B Leg Object isvalid

  if(sobj){
    if(sobj->sofianh){
      SofiaBindhandle(sobj->sofianh, NULL);
      nua_handle_destroy(sobj->sofianh);
    } // Leg A handle clean up This stops the even for Leg A
    if(sobj->SofiaLegB){
      if(sobj->SofiaLegB->sofianh){
        SofiaBindhandle(sobj->SofiaLegB->sofianh, NULL);
        nua_handle_destroy(sobj->SofiaLegB->sofianh);
      } // Leg B handle clean up this stops the event for Leb B
      // Deleting Leg B First;
      sobj->SofiaLegB->DeleteAll();
      delete sobj->SofiaLegB;
    } 
    // Deleting Leg A Obj
    sobj->DeleteAll();
    delete sobj;
  }
  return true;
}
bool SofiaSiphandler::CheckCodecCompatablity(xGateAVCodec *avcodec){
  for(int i =0; i < MAXAVCODEC ; i++){
    //printf("code List %s\n", avcodec[i].name.c_str());
    if(GetCodecFromList(avcodec[i].payloadtype) >= 0)
      return true;
  }
  //printf("Return false from CheckCodecCompatablity\n");
  return false;
}
sdp_rtpmap_t *SofiaSiphandler::CheckCodecCompatablity(sdp_session_t *rsdp){
  if(rsdp){
    sdp_rtpmap_t *rtpmap = rsdp->sdp_media->m_rtpmaps;
    while(rtpmap != NULL){
      if(GetCodecFromList(rtpmap->rm_pt) >= 0)
        return rtpmap;
      rtpmap = rtpmap->rm_next;	 
    }
  }
  return NULL;
} 
int SofiaSiphandler::GetCodecFromList(int payload){
  int ret = -1;
  for (int index=0 ; index < MAXCODEC ; index++){
    if (xGateCodecList[index].payload == payload)
      return index;
  }
  return ret;
}
std::string SofiaSiphandler::Authenticating(xGateSofiaobj *sobj, sip_www_authenticate_t const *auth){
  std::string ret = "";
  if(sobj){
    if(strlen(sobj->cp.credential.crUserName.c_str()) > 0 && strlen(sobj->cp.credential.crPassword.c_str()) > 0){
      if(auth){
        ret = auth->au_scheme;
        sip_www_authenticate_t const *authloop = auth;
        while(authloop){
          const char * realm = strstr((char*)authloop->au_params, "realm=");
          if(realm){
            realm += 6;
            ret += ":" ;
            ret += realm;
            break;
          }
          authloop = authloop->au_next;
        }// for loop
        ret += ":" ;
        ret += sobj->cp.credential.crUserName;
        ret += ":";
        ret += sobj->cp.credential.crPassword;   
      }
    }
  }
  return ret;
}
/**/
bool SofiaSiphandler::CreateSofiaRegobj(xGateSofiaSipRegobj &regparam,sip_t const  *sip){
  regparam.callid = sip->sip_call_id->i_id;


  regparam.proxyusername = sip->sip_contact->m_url->url_user;
  regparam.ipaddress = sip->sip_contact->m_url->url_host;
  regparam.contactaddress = sip->sip_contact->m_url->url_host;
  if(sip->sip_contact->m_url->url_port){
    regparam.contactaddress +=  ":";
    regparam.contactaddress += sip->sip_contact->m_url->url_port;
    printf("New Registration contact address %s\n",regparam.contactaddress.c_str());
  }

  //	regparam.domainname = sip->sip_from->a_url->url_host;
  regparam.domainname = sip->sip_request->rq_url->url_host;	
  regparam.username = sip->sip_to->a_url->url_user;
  regparam.mobileno = sip->sip_to->a_url->url_user; 
  if( sip->sip_user_agent && sip->sip_user_agent->g_string ){
    if(strstr(sip->sip_user_agent->g_string,"DCAPP"))
      regparam.devicetype =  "DCAPP" ;
    else if (strstr(sip->sip_user_agent->g_string,"VAPP"))
      regparam.devicetype =  "VAPP";
    else 
      regparam.devicetype =  "URAPP";
  }else 
    regparam.devicetype =  "URAPP";



  regparam.aaa =  EN_AAA_AUTHEN;
  regparam.Regevent = EN_VALIDATE;
  if(sip->sip_authorization && sip->sip_authorization->au_params ){
    regparam.username = msg_params_find(sip->sip_authorization->au_params,"username=");
    regparam.password =""; 
    regparam.Regevent = EN_GETUSRPWD; 
    CLog::Detail(THISMODULE, "****************username == %s & password == %s", regparam.username ,regparam.password);
    /*char *authstr = (char*)sip->sip_authorization->au_params;
      char *rauthstr = authstr;
      char *token;
      while(token = strtok_r(authstr,",",&rauthstr)){ // r token to support multi thread enviroment
      char *temptok;
      if(temptok = strstr(token,"username="))
      regparam.username = temptok;
      else if(temptok = strstr(token, "response="))
      regparam.password = temptok;
      }*/
  }else if(sip->sip_proxy_authorization && sip->sip_proxy_authorization->au_params ){
    regparam.username = msg_params_find(sip->sip_proxy_authorization->au_params,"username=");
    regparam.mobileno = sip->sip_from->a_url->url_user;
    regparam.password ="";
    regparam.Regevent = EN_AUTHCALL;

  }
  regparam.cseq = sip->sip_cseq->cs_seq;
  if(sip->sip_expires){ // TODO need logic to loop all the conatct to be deleted if expire = 0 as per rfc 3261
    regparam.expries =(int) sip->sip_expires->ex_delta;
    if(regparam.expries == 0)
      regparam.Regevent = EN_GETUSRPWD;
  }
  else if(sip->sip_contact && sip->sip_contact->m_expires){
    regparam.expries =atoi(sip->sip_contact->m_expires);
    if(regparam.expries == 0)
      regparam.Regevent = EN_GETUSRPWD;
  }else
    regparam.expries = 3600; 
  regparam.regsip =  (void*)sip; 

  return true;
}
void SofiaSiphandler::SDPPharser(sdp_session_t *rsdp,xGateSDPInfo &sdpinfo){
  // Check the media poto type
  // UNKNOWN,TCP,Plain UDP,RTP/UDP, RTP/SAVP,UDPTL, TLS, wildcard
  CLog::Detail(THISMODULE,"SofiaSiphandler::SDPPharser");
  switch(rsdp->sdp_media->m_proto){
    case sdp_proto_x:{ // Unknown may be any introduce in future will have this proto type.currently SAVPF
                       CLog::Detail(THISMODULE,"SofiaSiphandler::SDPPharser sdp_proto_x");
                       IceCandidatePharser(rsdp,sdpinfo);
                     }
                     break;
    case sdp_proto_srtp:{ // RTP/SAVP is the proto supported
                          CLog::Detail(THISMODULE,"SofiaSiphandler::SDPPharser sdp_proto_srtp");
                          IceCandidatePharser(rsdp,sdpinfo);
                        }
                        break;
    case sdp_proto_tcp:
                        CLog::Detail(THISMODULE,"SofiaSiphandler::SDPPharser sdp_proto_tcp");
                        break;
    case sdp_proto_udp:
                        CLog::Detail(THISMODULE,"SofiaSiphandler::SDPPharser sdp_proto_udp");
                        break;
    case sdp_proto_rtp:{ // RTP/AVP is the proto supported
                         CLog::Detail(THISMODULE,"SofiaSiphandler::SDPPharser sdp_proto_rtp");
                         RtpAvpPharser(rsdp,sdpinfo);
                       }
                       break;
    case sdp_proto_udptl:
                       CLog::Detail(THISMODULE,"SofiaSiphandler::SDPPharser sdp_proto_udptl");
                       break;
    case sdp_proto_tls:
                       CLog::Detail(THISMODULE,"SofiaSiphandler::SDPPharser sdp_proto_tls");
                       break;
    case sdp_proto_any:
                       CLog::Detail(THISMODULE,"SofiaSiphandler::SDPPharser sdp_proto_any");
                       break;
    default:
                       CLog::Detail(THISMODULE,"SofiaSiphandler::SDPPharser default");
                       break;
  }

}
void SofiaSiphandler::SetSDPAnswer(sdp_session_t &dup, std::string tagname){
  sdp_attribute_t* iceattributes = NULL;
  sdp_session_t* rsdp =  &dup;
  if(rsdp){
    if(rsdp->sdp_media->m_attributes){
      iceattributes = rsdp->sdp_media->m_attributes;
    }

  }
  while(iceattributes){
    if(strcmp(iceattributes->a_name,"setup") == 0){
      iceattributes->a_value =  "active";
      cout << "setup " << iceattributes->a_value << endl;
      break;
    }
    iceattributes = iceattributes->a_next;
  }
}
void SofiaSiphandler::IceCandidatePharser(sdp_session_t *rsdp,xGateSDPInfo &sdpinfo){
  // rtp map is in atrribute paramater
  sdp_attribute_t* iceattributes = NULL;
  if(rsdp){
    if(rsdp->sdp_media){
      sdpinfo.mediatype = rsdp->sdp_media->m_type;
      if(rsdp->sdp_connection && rsdp->sdp_connection->c_address)
        sdpinfo.ipaddress =rsdp->sdp_connection->c_address;
      else if(rsdp->sdp_media->m_connections && rsdp->sdp_media->m_connections->c_address)
        sdpinfo.ipaddress =  rsdp->sdp_media->m_connections->c_address;
      sdpinfo.port = rsdp->sdp_media->m_port;

      if(rsdp->sdp_media->m_attributes){
        iceattributes =  rsdp->sdp_media->m_attributes;
      }
      if(rsdp->sdp_media->m_proto_name)
        if(strstr(rsdp->sdp_media->m_proto_name,"UDP/TLS/RTP/SAVPF"))
          sdpinfo.mediamode = "DTLS";
        else sdpinfo.mediamode = "SRTP";

    }
  }
  // TODO need to implement video codec
  int i = 0;
  while (iceattributes){
    //printf("ice attribute %s\n", iceattributes->a_name);
    if(strcmp(iceattributes->a_name,"ice-ufrag") == 0)
      sdpinfo.iceufrag = iceattributes->a_value;
    if(strcmp(iceattributes->a_name,"ice-pwd") == 0)
      sdpinfo.icepwd = iceattributes->a_value;
    if(strcmp(iceattributes->a_name,"fingerprint") == 0)
      sdpinfo.fingerprint =  iceattributes->a_value;
    if(strcmp(iceattributes->a_name,"rtpmap") == 0){
      if(i < MAXAVCODEC){
        sdpinfo.audiocodec[i].Value = iceattributes->a_value;
        sdpinfo.audiocodec[i].ExtractCodecInfo(sdpinfo.audiocodec[i].Value);
        i++;
      }
    }
    if(strcmp(iceattributes->a_name,"candidate") == 0){
      std::string temp =  iceattributes->a_value;
      char *token =  strtok(temp.c_str()," ");
      std::string ipaddr="",port="";
      int count  = 1 ;
      while(token){
        if (count == 9) break;
        switch(count){
          case 5:
            ipaddr = token;
            break;
          case 6:
            port = token;
            break;
          case 8:
            if(strstr(token,"relay")){
              sdpinfo.relayip = ipaddr;
              sdpinfo.relayport = atoi(port.c_str()); 
            }else if (strstr(token,"srflx")){
              sdpinfo.reflexip = ipaddr;
              sdpinfo.reflexport = atoi(port.c_str());
            }else {
              sdpinfo.ipaddress = ipaddr;
              sdpinfo.port = atoi(port.c_str());
            }
            break;
          default:
            break;
        }
        count ++;
        token = strtok(NULL," ");
      }
    }
    iceattributes = iceattributes->a_next;
  }
}
void SofiaSiphandler::RtpAvpPharser(sdp_session_t *rsdp,xGateSDPInfo &sdpinfo){
  sdp_rtpmap_t *rtpmaps = NULL;
  sdp_attribute_t *rtpatt = NULL;
  if(rsdp){
    if(rsdp->sdp_media){
      sdpinfo.mediatype = rsdp->sdp_media->m_type;
      if(rsdp->sdp_connection && rsdp->sdp_connection->c_address)
        sdpinfo.ipaddress =rsdp->sdp_connection->c_address;
      else if(rsdp->sdp_media->m_connections && rsdp->sdp_media->m_connections->c_address)
        sdpinfo.ipaddress =  rsdp->sdp_media->m_connections->c_address;

      sdpinfo.port = rsdp->sdp_media->m_port;
      if(rsdp->sdp_media->m_rtpmaps)
        rtpmaps = rsdp->sdp_media->m_rtpmaps;
      sdpinfo.mediamode = "RTP";
      if(rsdp->sdp_media->m_attributes){
        rtpatt =  rsdp->sdp_media->m_attributes;
      }
    }
    if(rsdp->sdp_attributes){
      rtpatt = rsdp->sdp_attributes;
    }

  }
  while(rtpatt){
	cout << "\nSWB : new rtp-attribute ....1 ********** = " << rtpatt->a_name;
    if(rtpatt->a_name && !strcmp(rtpatt->a_name, "ptime")){
      //    sdpinfo.ptime = (int*)rtpatt->a_value;
      sdpinfo.ptime = atoi(rtpatt->a_value);
      if(sdpinfo.ptime > 30)
        sdpinfo.ptime = 0;
      break;
    }
    rtpatt =  rtpatt->a_next;
  }

  int i =0;
  while(rtpmaps){
	cout << "\nSWB : new rtpmaps ....2 ********** = " << rtpmaps->rm_encoding;
	cout << "\nSWB : new rtpmaps ....2 ********** = " << rtpmaps->rm_fmtp;
    //printf("codec rtpaavp %s\n",rtpmaps->rm_encoding);
    if(i < MAXAVCODEC){
    	if (rtpmaps->rm_encoding && !strcmp(rtpmaps->rm_encoding, "telephone-event"))
    		if (rtpmaps->rm_fmtp && !strcmp(rtpmaps->rm_fmtp, "101"))
			cout << "\nSWB : TELEPHONE-EVENT 101********\n";		
		
      sdpinfo.audiocodec[i].name = rtpmaps->rm_encoding;
      sdpinfo.audiocodec[i].samplingrate = rtpmaps->rm_rate;
      if(rtpmaps->rm_fmtp)
        sdpinfo.audiocodec[i].fmtp = rtpmaps->rm_fmtp;
      if(rtpmaps->rm_pt)
        sdpinfo.audiocodec[i].payloadtype = rtpmaps->rm_pt;
      i++;
    }
    rtpmaps = rtpmaps->rm_next;
  }

}
/*
 * */
void SofiaSiphandler::RequestForMedia(xGateSofiaobj *sofiaobjsiphandle,XGATEMGUPDATE mgMsgType=EN_MEDIA_CREATE){

  if(sofiaobjsiphandle->callstream == EN_INBOUND &&  CheckCodecCompatablity(sofiaobjsiphandle->SofiaSDPinfo.audiocodec) == false) {
    RespondToPeer(EN_488_REL,sofiaobjsiphandle);
    RequestTermination(sofiaobjsiphandle); // Requesting SL application to stop the processing
    DeleteSofiaObject(sofiaobjsiphandle); // Deleting the object so it won't get further process or event
    CLog::Detail(THISMODULE,"SofiaSiphandler::RequestForMedia(%s) Codec Compatablity failed ",sofiaobjsiphandle->callid.c_str());
    return;
  }

  if(PostMessageToMGCDispatcher(sofiaobjsiphandle,mgMsgType) == true){
    if (sofiaobjsiphandle->mediastate != EN_MED_SUSPENDED && sofiaobjsiphandle->mediastate != EN_MED_RESUMED) // This need to re-vist Yadav
      sofiaobjsiphandle->mediastate = EN_MED_REQ;
    //printf("Post Message To dispatch Success %s\n",sofiaobjsiphandle->callid.c_str());
    CLog::Detail(THISMODULE,"SofiaSiphandler::RequestForMedia(%s) Media Direction  %d ",sofiaobjsiphandle->callid.c_str(),sofiaobjsiphandle->callstream );
  }else{
    RespondToPeer(EN_503_REL,sofiaobjsiphandle);
    RequestTermination(sofiaobjsiphandle); // Reqting SL application to stop the processing
    DeleteSofiaObject(sofiaobjsiphandle);
    CLog::Detail(THISMODULE,"SofiaSiphandler::RequestForMedia(%s) Post Message Failed  %d ",sofiaobjsiphandle->callid.c_str(),sofiaobjsiphandle->callstream );
  }


}

void SofiaSiphandler::OnHold_Resume(xGateSofiaobj *sobj){

  CLog::Detail(THISMODULE,"SofiaSiphandler::OnHold_Resume %s",sobj->callid.c_str() );
  bool ONHOLD = true;
  bool ONRESUME = false;

  if(sobj->callstate == CS_Suspended && sobj->mediastate == EN_MED_SUSPENDED) // On Hold Leg A peer send to Leg B
  {
    // Forward the Invite B Party 
    ForwardReInvite(sobj,ONHOLD);
    // Send 200 ok to  A Party
    // RespondToPeer(EN_200_REL,sobj);
  }else if(sobj->SofiaLegB->callstate == CS_Suspended && sobj->SofiaLegB->mediastate == EN_MED_SUSPENDED) // On Hold Leg B send to Leg A
  {
    //Forward the Invite to A Party

    ForwardReInvite(sobj->SofiaLegB,ONHOLD);
    //Send 200 ok to B Party
    // RespondToPeer(EN_200_REL,sobj->SofiaLegB);

  }else if(sobj->callstate == CS_Connecting && sobj->mediastate == EN_MED_RESUMED) {// On Resume Leg A peer send to Leg B
    // Forward the Invite to  B Party
    ForwardReInvite(sobj,ONRESUME);
    // Send 200 ok to A Party
    RespondToPeer(EN_200_REL,sobj);
  }else if(sobj->SofiaLegB->callstate == CS_Connecting && sobj->SofiaLegB->mediastate == EN_MED_RESUMED) {// OnResume Leg B send to Leg A
    // Forward the Invite to A Party
    ForwardReInvite(sobj->SofiaLegB,ONRESUME);
    // Send 200 ok to B Party
    // RespondToPeer(EN_200_REL,sobj->SofiaLegB);
  }

  // This for Hold on 
  //else if(sobj->callstate == CS_Suspended)
  // This for Resume
}

xGateReturn SofiaSiphandler::ForwardReInvite(xGateSofiaobj *sofiaobj, bool hold_resume){
  CLog::Detail(THISMODULE, "SofiaSiphandler::ForwardReInvite(%s) Request", sofiaobj->callid.c_str());
  if( CreateLocalSdpParam(sofiaobj) == true)
  {
    CLog::Detail(THISMODULE, "SofiaSiphandler::ForwardReInvite CreateLocalSdpParam(sofiaobj) == true");
    nua_set_hparams(sofiaobj->SofiaLegB->sofianh, TAG_IF(hold_resume,SOATAG_HOLD("audio")), TAG_IF(!hold_resume,SOATAG_HOLD("")),TAG_END());
    nua_invite(sofiaobj->SofiaLegB->sofianh,NUTAG_AUTOACK(1),TAG_END());
    CLog::Detail(THISMODULE, "SofiaSiphandler::ForwardReInvite Sent out....");
  }
  else
  {
    CLog::Detail(THISMODULE, "SofiaSiphandler::ForwardReInvite CreateLocalSdpParam(sofiaobj) == FALSE");
    RespondToPeer(EN_503_REL,sofiaobj);
  }
  music_on_hold(sofiaobj,hold_resume);
  return SUCCESS;
}

xGateReturn SofiaSiphandler::music_on_hold(xGateSofiaobj *sofiaobj, bool ONHOLD)
{
  // will play music-on-hold or stop playing it during call-resume...
  if (sofiaobj->callstream == EN_OUTBOUND)
  {
    CLog::Detail(THISMODULE, "SofiaSiphandler::music_on_hold cp.callOnHoldFilenameCalledParty = %s", sofiaobj->SofiaLegB->cp.callOnHoldFilenameCalledParty.c_str());
    sofiaobj->cp.Legid = 1;
    sofiaobj->cp.csfilename = sofiaobj->SofiaLegB->cp.csfilename = sofiaobj->SofiaLegB->cp.callOnHoldFilenameCalledParty; 
  }
  else
  { // else resume/hold from caller
    CLog::Detail(THISMODULE, "SofiaSiphandler::music_on_hold cp.callOnHoldFilenameCallingParty = %s", sofiaobj->cp.callOnHoldFilenameCallingParty.c_str());
    sofiaobj->cp.Legid = 2;
    sofiaobj->cp.csfilename = sofiaobj->SofiaLegB->cp.csfilename = sofiaobj->cp.callOnHoldFilenameCallingParty;
  }

  if (ONHOLD)
  {
    sofiaobj->cp.PbState = EN_XGATE_PB_HOLD;
    CLog::Detail(THISMODULE, "SofiaSiphandler::music_on_hold ONHOLD ");
  }
  else // else on-resume
  {
    sofiaobj->cp.PbState = EN_XGATE_PB_RESUME;
    CLog::Detail(THISMODULE, "SofiaSiphandler::music_on_hold ONRESUME ");
  }
  RequestForMedia(sofiaobj,EN_MEDIA_HOLD_RESUME);
  sofiaobj->cp.csfilename = "";
  sofiaobj->SofiaLegB->cp.csfilename = "";
  return SUCCESS;
}

