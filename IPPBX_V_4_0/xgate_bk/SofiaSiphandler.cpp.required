/* This functionality will handle the reponse event from Sip Leg's 
 * and post the information to Main or Sip processor thread for further manipulation, 
 * */
void SofiaSiphandler::OnRequestResponse(int status,char const *phrase,nua_t *nua,\  
    nua_magic_t  *magic,nua_handle_t *nh,nua_hmagic_t *hmagic,sip_t const  *sip,  
    tagi_t        tags[]){

  CLog::Detail(THISMODULE,"SofiaSiphandler::OnRequestResponse(%d)",status);
  ((xGateSofiaobj*)hmagic)->siptag = sip;
  //  ((xGateSofiaobj*)hmagic)->SofiaLegB->sipeventtype= status;
  // Since reply from peer B reply send back to be peer A should be done
  // so SofiaLegB of peer B is peer A
  if(CheckResponseRequired(status,(xGateSofiaobj*)hmagic)== false){
  CLog::Detail(THISMODULE,"SofiaSiphandler::OnRequestResponse(CheckResponseRequired) return false");
    return; 
}
     RespondToPeer(status,((xGateSofiaobj*)hmagic)->SofiaLegB);

  // TODO write sperate function to Authentication reply

  xGateCallObj *callobj =  new xGateCallObj;
  callobj->xGateCallObjInit();
  callobj->callid = ((xGateSofiaobj*)hmagic)->callid;
  callobj->cp = ((xGateSofiaobj*)hmagic)->cp;
  if(status > 399){
    callobj->sipeventtype = XGATESIPEVENT::EN_TERMINATED_REQ;
    callobj->callstate = CS_Disconnected;
  }
  else{
    callobj->sipeventtype = XGATESIPEVENT::EN_INVITE_RES;
  }

  switch(status){
    case 183:
      if(((xGateSofiaobj*)hmagic)->callstate < CS_Proceeding){
        ((xGateSofiaobj*)hmagic)->callstate = CS_Proceeding;
        ((xGateSofiaobj*)hmagic)->SofiaLegB->callstate = CS_Proceeding;
        callobj->callstate = CS_Proceeding;
      }
      break;
    case 180:
      if(((xGateSofiaobj*)hmagic)->callstate < CS_Alerting){
        ((xGateSofiaobj*)hmagic)->callstate = CS_Alerting;
        ((xGateSofiaobj*)hmagic)->SofiaLegB->callstate = CS_Alerting;
        callobj->callstate = CS_Alerting;
      }
      break;;
    case 200: 
      if(((xGateSofiaobj*)hmagic)->callstate <= CS_Connected) { // TODO  need verification the logic yadav
        ((xGateSofiaobj*)hmagic)->callstate = CS_Connected;
        ((xGateSofiaobj*)hmagic)->SofiaLegB->callstate = CS_Connected;
        callobj->callstate = CS_Connected;
      }else if(((xGateSofiaobj*)hmagic)->callstate ==  CS_Mediawait) {
        callobj->callstate = CS_Connected;
      }
	if ((!((xGateSofiaobj*)hmagic)->SofiaLegB->cp.rbtFile.empty()) ||
		(!((xGateSofiaobj*)hmagic)->SofiaLegB->cp.csfilename.empty())) {
	   CLog::Detail(THISMODULE, "SofiaSiphandler::OnRequestResponse : case 200; stop playing RBT...");
          ((xGateSofiaobj*)hmagic)->SofiaLegB->cp.PbState = EN_XGATE_PB_STOP;
          ((xGateSofiaobj*)hmagic)->SofiaLegB->cp.rbtFile =  "";
          ((xGateSofiaobj*)hmagic)->SofiaLegB->cp.csfilename =  "";
          ((xGateSofiaobj*)hmagic)->SofiaLegB->cp.Legid = 1; //TODO: stop rbt for origination leg
	RequestForMedia(((xGateSofiaobj*)hmagic)->SofiaLegB, EN_MEDIA_UPDATE);
	}
      break;
    case 404:
      callobj->callcauseB = CC_NoRouteToDestination;
      break;
    case 486:
      callobj->callcauseB = CC_UserBusy;
      break;
    case 408:
      callobj->callcauseB = CC_NoUserResponding;
      break;
    case 480:
      callobj->callcauseB = CC_NoAnswerFromUser;
      break;
    case EN_403_REL:
      callobj->callcauseB = CC_CallRejected;
      break;	
    case EN_503_REL:
      callobj->callcauseB = CC_ResourceUnavailable;
      break;
    default:
      if(status > 399)
        callobj->callcauseB = CC_NormalUnspecified;
      break;

  }
  PostMessage(callobj,XGATEPOSTTYPE::EN_PROCESS);

}
void SofiaSiphandler::OnByeRequest(int status,char const *phrase,nua_t *nua,\
    nua_magic_t  *magic,nua_handle_t *nh,nua_hmagic_t *hmagic,sip_t const  *sip,
    tagi_t        tags[]){

  if(!hmagic)
    return;
  xGateSofiaobj x;
//   if(GetCallInfo(&x,((xGateSofiaobj*)hmagic)->callid) == true){

 

// TODO Since URAPP is sending bye for busy case on forking explicitly we are doing this , if they rectify this can be deleted -- Yadav
   if(((xGateSofiaobj*)hmagic)->callstream == EN_OUTBOUND ){
    if(((xGateSofiaobj*)hmagic)->SofiaLegB->callstate <  CS_Connected || ((xGateSofiaobj*)hmagic)->callstate < CS_Connected)
     return;
   if(((xGateSofiaobj*)hmagic)->cp.isForkingenabled )
    if(((xGateSofiaobj*)hmagic)->SofiaLegB->SofiaForkLeg.size() > 1)
   return; 
}
  SofiaRespond(nh,200,"OK");
  xGateCallObj *callobj =  new xGateCallObj;
  callobj->xGateCallObjInit();
  callobj->callid = ((xGateSofiaobj*)hmagic)->callid;
  callobj->sipeventtype = XGATESIPEVENT::EN_BYE_REQ;
  callobj->cp = ((xGateSofiaobj*)hmagic)->cp;
  PostMessage(callobj,EN_PROCESS);

  // Disconnect the peer call, no ack will be take from soifa call back
  if(((xGateSofiaobj*)hmagic)->SofiaLegB){
    if(((xGateSofiaobj*)hmagic)->SofiaLegB->sofianh)
      SofiaSendBye(((xGateSofiaobj*)hmagic)->SofiaLegB->sofianh);
  }
  //    nua_bye(((xGateSofiaobj*)hmagic)->SofiaLegB->sofianh,TAG_END());
  // }
  // Deleteting all the call info both peer
  DeleteCallInfo(((xGateSofiaobj*)hmagic));
}

