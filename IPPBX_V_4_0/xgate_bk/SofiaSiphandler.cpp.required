    sofiaobj->cp.cnCalled = siptag->sip_contact->m_url->url_user; // added for multithreaded-ippbx
  }
  /*        CLog::Detail(THISMODULE, "multithreaded-ippbx : callid = %s" , sofiaobj->callid.c_str());
            CLog::Detail(THISMODULE,  "multithreaded-ippbx : sipeventtype = %d" , sofiaobj->sipeventtype);

            CLog::Detail(THISMODULE,  "multithreaded-ippbx : cnCalled = %s" , sofiaobj->cp.cnCalled);
            CLog::Detail(THISMODULE,  "multithreaded-ippbx : cnCalled = %s" , sofiaobj->cp.cnCalled.c_str());
  ////CLog::Detail(THISMODULE,  "multithreaded-ippbx : cnpCalled = %s" , sofiaobj->cp.cnpCalled.c_str());
  ////CLog::Detail(THISMODULE,  "multithreaded-ippbx : cntCalled = %s" , sofiaobj->cp.cntCalled.c_str());
  CLog::Detail(THISMODULE,  "multithreaded-ippbx : csCalled = %s" , sofiaobj->cp.csCalled.c_str());
  CLog::Detail(THISMODULE,  "multithreaded-ippbx : csaCalled = %s" , sofiaobj->cp.csaCalled.c_str());

  ////CLog::Detail(THISMODULE,  "multithreaded-ippbx : cpcCalling = %s" , sofiaobj->cp.cpcCalling.c_str());
  CLog::Detail(THISMODULE,  "multithreaded-ippbx : cnCalling = %s" , sofiaobj->cp.cnCalling.c_str());
  CLog::Detail(THISMODULE,  "multithreaded-ippbx : cnCallingOrig = %s" , sofiaobj->cp.cnCallingOrig.c_str());
