  CLog::Detail(THISMODULE,  "multithreaded-ippbx : csCalling = %s" , sofiaobj->cp.csCalling.c_str());
  CLog::Detail(THISMODULE,  "multithreaded-ippbx : csaCalling = %s" , sofiaobj->cp.csaCalling.c_str());
  CLog::Detail(THISMODULE,  "multithreaded-ippbx : csaCalling = %s" , sofiaobj->cp.csaCalling.c_str());*/

