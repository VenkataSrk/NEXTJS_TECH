        TAG_IF(!scheme.empty(), SIPTAG_HEADER_STR(scheme.c_str())),\
        NUTAG_AUTOANSWER(0),\
        TAG_END());

//    if(nhob)
  //    sobj->SofiaLegB->sofianh = (void*)nhob;
   // else
     // sobj->SofiaLegB->sofianh = NULL;

