//Yoga
bool SofiaSiphandler::UpdateSofiaobjParam(xGateSofiaobj **sobj, xGateCallState *event){
  CLog::Detail(THISMODULE,"SofiaSiphandler::UpdateSofiaobjParam(%s)",event->callid.c_str());
  if((*sobj)->mediastate == EN_MED_REQ){
    (*sobj)->mediastate = EN_MED_SET;
    (*sobj)->ipaddr = event->ipaddr;
    (*sobj)->port = event->port;
    (*sobj)->codec = event->codec;
    (*sobj)->SofiaSDPinfo.iceufrag = event->ice_ufrag;
    (*sobj)->SofiaSDPinfo.icepwd = event->ice_pwd;
    (*sobj)->SofiaSDPinfo.fingerprint = event->fingerprint;
    (*sobj)->SofiaSDPinfo.ssrc = event->ssrc;
    (*sobj)->SofiaSDPinfo.cname = event->cname;
    (*sobj)->SofiaSDPinfo.mslabel = event->mslabel;
    (*sobj)->SofiaSDPinfo.label = event->label;
    (*sobj)->SofiaSDPinfo.mediamode = event->media_proto;
    return true;
  }
  return false;
}

void SofiaSiphandler::OnProcessEvent(xGateSofiaobj *sobj, xGateCallState *event)
{
 CLog::Detail(THISMODULE,"SofiaSiphandler::OnProcessEvent(%s)",event->callid.c_str());
 switch(event->sipeventtype){
  case EN_SETMEDIA_REL:{
   switch(event->calldir){
    case EN_INBOUND:{
     CLog::Detail(THISMODULE, "SofiaSiphandler::OnProcessEvent DialOut called %s",sobj->callid.c_str());
     UpdateSofiaobjParam(&sobj,event);
     // Check for Early Message
     if(sobj->cp.csfilename.empty())
      ((SofiaSiphandler*)((nua_magic_t*)sobj->sofiamh))-> DialOut(sobj);
     else{
      if((sobj->cp._isSwitchBoardCall) && (sobj->switchboardparam.SwbCallEvent != EN_SWB_GETDTMF))
       		sobj->switchboardparam.SwbCallEvent =  EN_SWB_WELCOME;
       RespondToPeer(EN_183_REL, sobj); // Early Media on Greeting or RBT
      }
    break;
    }
    case EN_OUTBOUND:{
     //CLog::Detail(THISMODULE, "SofiaSiphandler::OnProcessEvent handling EN_OUTBOUND");
     CLog::Detail(THISMODULE, "SofiaSiphandler::OnProcessEvent RespondToPeer called %s",sobj->callid.c_str());
     UpdateSofiaobjParam(&sobj->SofiaLegB,event);
     //if call stat still in progress/alerting, send media detail to client through sdp for RBT
     if(sobj->SofiaLegB->callstate == CS_Proceeding) {
      RespondToPeer(EN_183_REL, sobj);
     }else if(sobj->SofiaLegB->callstate == CS_Alerting) {
      RespondToPeer(EN_180_REL, sobj);
     }else if(sobj->SofiaLegB->callstate == CS_Connected){
      RespondToPeer(EN_200_REL,sobj);
      sobj->SofiaLegB->callstate = CS_Connected;
     }
    }
    break;
    default:{
     CLog::Detail(THISMODULE, "SofiaSiphandler::OnProcessEvent EN_SETMEDIA_REL case default %s", sobj->callid.c_str());
     break;
    }
   }
  break;
  }
  case EN_PB_COMPLETE_REL:{
   CLog::Detail(THISMODULE,"SofiaSiphandler::OnProcessEvent EN_PB_COMPLETE_REL %s",sobj->callid.c_str());
   if(sobj->cp._isSwitchBoardCall){
    CLog::Detail(THISMODULE, "SofiaSiphandler::OnProcessEvent cp._isSwitchBoardCall == true");
   if(sobj->switchboardparam.SwbCallEvent == EN_SWB_PLAY)
    sobj->switchboardparam.SwbCallEvent = EN_SWB_PLAY_COMPLET;
   if(sobj->switchboardparam.SwbCallEvent != EN_SWB_PLAY_PASSTHROUGH)
    OnSwitchBoardCallProcess(sobj);
   //RespondToPeer(EN_200_REL, sobj);
  break;
  }
	if(!sobj->cp.callForwardingFile.empty())
	{
		sobj->cp.PbState = EN_XGATE_PB_PLAY;
		sobj->cp.Legid = 1;// TODO  Yadav Chang the Leg ID to 2 since this leb B (this code is for temp need to revert after testeing)
		RequestForMedia(sobj, EN_MEDIA_UPDATE);
		sobj->cp.callForwardingFile = "";
		break;
	}

   ((SofiaSiphandler*)((nua_magic_t*)sobj->sofiamh))-> DialOut(sobj);
   sobj->mediastate = EN_MED_CONNECTED;
   if(!sobj->cp.rbtFile.empty()) {
    sobj->cp.PbState = EN_XGATE_PB_REPEAT;
    sobj->cp.csfilename =  sobj->cp.rbtFile;
    sobj->cp.Legid = 1;// TODO  Yadav Chang the Leg ID to 2 since this leb B (this code is for temp need to revert after testeing)
    RequestForMedia(sobj, EN_MEDIA_UPDATE);   
   }
  break;	
  }
  case EN_HOLDRESUME_RES:{
   OnHold_Resume(sobj); // sobj is A Leg Peer
  break;
  }
  case EN_P2PMEDIA_RES:{
  break;
  }
  case EN_DIALOUT_REL:{
   CLog::Detail(THISMODULE,"SofiaSiphandler::OnProcessEvent EN_DIALOUT_REL %s",sobj->callid.c_str());
   // The cp (CallParameter) updation is requied all case except EN_SETMEDIA_REL
   sobj->cp = event->cp;
   if(sobj->callstate < event->callstate)
    sobj->callstate = event->callstate;
    sobj->P2PMedia =  CheckforP2PMedia(sobj);
    if(sobj->P2PMedia == 0){
     sobj->SofiaSDPinfo.outproto = "DTLS";
   //sobj->SofiaSDPinfo.outproto = GetRtpPortType(sobj);
     sobj->cp.csfilename = event->cp.csfilename;
     sobj->cp.callOnHoldFilenameCallingParty = event->cp.callOnHoldFilenameCallingParty;
     sobj->cp.callOnHoldFilenameCalledParty = event->cp.callOnHoldFilenameCalledParty;
	sobj->cp.callForwardingFile = event->cp.callForwardingFile;
     sobj->cp.PbState = 1;
     sobj->cp.Legid = 1;
     ((SofiaSiphandler*)((nua_magic_t*)sobj->sofiamh))-> RequestForMedia(sobj);
     //User greeting play
     if(!sobj->cp.csfilename.empty()){
      sobj->SofiaLegB->callstate = CS_Proceeding;
      sobj->SofiaLegB->callstream = EN_OUTBOUND;
      sobj->SofiaLegB->cp.csfilename =  sobj->cp.csfilename;
      sobj->SofiaLegB->cp.PbState = 1;
      sobj->SofiaLegB->cp.Legid = 1 ;// TODO  Yadav Chang ethe Leg ID to 2 since this leb B (this code is for temp need to revert after testeing)
      sobj->cp.callOnHoldFilenameCallingParty = event->cp.callOnHoldFilenameCallingParty;
      sobj->cp.callOnHoldFilenameCalledParty = event->cp.callOnHoldFilenameCalledParty;
      sobj->cp.rbtFile = event->cp.rbtFile;
	sobj->cp.callForwardingFile = event->cp.callForwardingFile;
	if(!sobj->cp.callForwardingFile.empty())
		sobj->SofiaLegB->cp.csfilename = sobj->cp.callForwardingFile;

      ((SofiaSiphandler*)((nua_magic_t*)sobj->sofiamh))-> RequestForMedia(sobj->SofiaLegB, EN_MEDIA_18X);   
     }
    }else
     ((SofiaSiphandler*)((nua_magic_t*)sobj->sofiamh))-> DialOut(sobj);
  break;
  }
  case EN_SWB_EVENT_REL:{
   CLog::Detail(THISMODULE,"SofiaSiphandler::OnProcessEvent EN_SWB_EVENT_REL  %s",sobj->cp.call_id.c_str());
   sobj->switchboardparam.PlayFile =  event->cp.swbinfo.PlayFile;
   sobj->switchboardparam.SwbCallEvent = event->cp.swbinfo.SwbCallEvent;
   sobj->switchboardparam.MaxDigit = event->cp.swbinfo.maxDigits;
   sobj->switchboardparam.DigitTimeOut = event->cp.swbinfo.DigitTimeOut;
   sobj->cp.cnCalled = event->cp.cnCalled ;
   sobj->cp.cnCalling = event->cp.cnCalling ;
   /////if(((sobj->cp.rtp_media_enabled) || (sobj->SofiaLegB->cp.rtp_media_enabled)) && (event->cp.swbinfo.SwbCallEvent == EN_SWB_GETDTMF)){
	if (event->cp.swbinfo.SwbCallEvent == EN_SWB_GETDTMF)
	{
    		CLog::Detail(THISMODULE,"SofiaSiphandler::OnProcessEvent : SwbCallEvent == EN_SWB_GETDTMF");
    		sobj->cp.PbState = EN_XGATE_PB_GETDIGIT;
    		sobj->cp.Legid = 1;
 		// post message to Dispatcher. 
    		((SofiaSiphandler*)((nua_magic_t*)sobj->sofiamh))-> RequestForMedia(sobj,EN_MEDIA_GET_DTMF_DIGITS);
   	}
	////else
    		OnSwitchBoardCallProcess(sobj);
  break;
  }
  case EN_CALLSTATE_UPDATE_REL:{
   if(sobj->callstate < event->callstate)
    sobj->callstate = event->callstate;
  // sobj->cp = event->cp;
   memcpy(&sobj->cp, &(event->cp),sizeof(event->cp));
   CLog::Detail(THISMODULE,"SofiaSiphandler::OnProcessEvent EN_CALLSTATE_UPDATE_REL  %s",sobj->cp.call_id.c_str());
  break;
  }
  case EN_NULL:{
   CLog::Detail(THISMODULE,"SofiaSiphandler::OnProcessEvent ==> %s","EN_NULL - No Action Required");
  break;
  }
  case EN_TERMINATED_REL:{ 
  // This case is for normal crearing from callmanager or term kill task cmd 
  // Excecute only  the peer nodes are valid and call state is conncted and media state is connected
  // TODO need to have a single code system /function to handle disconnection Yadav
   CLog::Detail(THISMODULE,"SofiaSiphandler::OnProcessEvent ==> %s","EN_TERMINATED_REL - disconnect peers");
    if(sobj && sobj->SofiaLegB){
     if(sobj->callstate == CS_Connected && sobj->mediastate == EN_MED_CONNECTED){
      SofiaSendBye(sobj->sofianh);
     }
     if(sobj->SofiaLegB->callstate == CS_Connected && sobj->SofiaLegB->mediastate == EN_MED_CONNECTED){
      SofiaSendBye(sobj->SofiaLegB->sofianh);
     }
     DeleteCallInfo(sobj);
     DeleteSofiaObject(sobj);
    }
  break;
  }
  case EN_MEDIA_UPDATE_REL:{
  // On Media update to MG
  //sobj->cp = event->cp;
   sobj->cp.csfilename = event->cp.csfilename;
   sobj->cp.PbState = event->cp.PbState;
   sobj->cp.Legid = event->cp.Legid;
   sobj->cp.callOnHoldFilenameCallingParty = event->cp.callOnHoldFilenameCallingParty;
   sobj->cp.callOnHoldFilenameCalledParty = event->cp.callOnHoldFilenameCalledParty;
   sobj->cp.callForwardingFile = event->cp.callForwardingFile;
   CLog::Detail(THISMODULE,"SofiaSiphandler::OnProcessEvent ==> call_id = %s EN_MEDIA_UPDATE_REL %s",\
   sobj->cp.call_id.c_str(),sobj->cp.csfilename.c_str());
   ((SofiaSiphandler*)((nua_magic_t*)sobj->sofiamh))-> RequestForMedia(sobj,EN_MEDIA_UPDATE);
  break;
  }
	/*****
      case EN_MEDIA_SWITCHBOARD_REQ:
          CLog::Detail(THISMODULE,"SofiaSiphandler::OnProcessEvent : EN_MEDIA_SWITCHBOARD_REQ");
          sobj->cp._isSwitchBoardCall = true;
          sobj->SofiaLegB->cp._isSwitchBoardCall = true;
                             break;
	*****/

  case EN_MEDIA_GETDIGIT_REQ: // On Media get dtmf digits
   sobj->cp.PbState = event->cp.PbState;
   sobj->cp.Legid = event->cp.Legid;
   CLog::Detail(THISMODULE,"SofiaSiphandler::OnProcessEvent ==> EN_MEDIA_GETDIGIT_REQ");
   ((SofiaSiphandler*)((nua_magic_t*)sobj->sofiamh))-> RequestForMedia(sobj,EN_MEDIA_GET_DTMF_DIGITS);
  break;
  case EN_MEDIA_RECVDIGIT_RES: // From Media dtmf digits are received.
   CLog::Detail(THISMODULE,"SofiaSiphandler::OnProcessEvent ==> EN_MEDIA_RECVDIGIT_RES");
	if ((sobj->cp.sipinfo_method == false) && (strlen(event->media_dtmf_digits.c_str()) > 0))
	{
		sobj->cp.inband_dtmf_method = true;
		sobj->cp.sipinfo_method = false;
   		sobj->switchboardparam.DigitReceived = event->media_dtmf_digits; 
   		sobj->switchboardparam.SwbCallEvent = EN_SWB_GETDTMF_COMPLET;
   		OnSwitchBoardCallProcess(sobj);
	}
  break;
  default:{
   CLog::Detail(THISMODULE,"SofiaSiphandler::OnProcessEvent ==> %s","Default");
   if(event->sipeventtype  > 399){
    // check incoming or out
    // Call the Responce 1xx to 6xx function
    if(event->calldir  ==  EN_INBOUND){
     sobj->cp = event->cp;
     RespondToPeer(event->sipeventtype,sobj);
    }
   }
  break;	
  }
 }
}
/**
 * */
void SofiaSiphandler::OnSwitchBoardCallProcess(xGateSofiaobj *sobj){
CLog::Detail(THISMODULE,"SofiaSiphandler::OnSwitchBoardCallProcess  event id %d callid  %s",sobj->switchboardparam.SwbCallEvent,sobj->cp.call_id.c_str());
switch(sobj->switchboardparam.SwbCallEvent){
	case EN_SWB_NULL:
		return;
	break;
	case EN_SWB_WELCOME:
	  sobj->switchboardparam.SwbCallEvent=  EN_SWB_IVRCONNECT;
          RespondToPeer(EN_200_REL,sobj);
	break;
	///case EN_SWB_IVRCONNECT:
	///break;
	case EN_SWB_PLAY:
	case EN_SWB_PLAY_PASSTHROUGH:
	 sobj->cp.PbState = EN_XGATE_PB_PLAY;
         sobj->cp.csfilename =  sobj->switchboardparam.PlayFile;
         sobj->cp.Legid = 1;// TODO  Yadav Chang the Leg ID to 2 since this leb B (this code is for temp need to revert after testeing)
         sobj->switchboardparam.DigitReceived = "$$$";
         RequestForMedia(sobj, EN_MEDIA_UPDATE);
	return;
	case EN_SWB_PLAY_COMPLET:
	sobj->switchboardparam.SwbCallEvent = EN_SWB_PLAY_COMPLET;
	break;
	case EN_SWB_GETDTMF:
	sobj->switchboardparam.SwbCallEvent = EN_SWB_GETDTMF;
	sobj->switchboardparam.DigitReceived = "$$$";
	CLog::Detail(THISMODULE,"SofiaSiphandler::OnSwitchBoardCallProcess  Wating for MAX Digit %d",sobj->switchboardparam.MaxDigit);
	return;
	case EN_SWB_GETDTMF_COMPLET:
	sobj->cp.csfilename = "";
	sobj->switchboardparam.PlayFile = "";
	sobj->switchboardparam.SwbCallEvent = EN_SWB_GETDTMF_COMPLET;
	CLog::Detail(THISMODULE,"SofiaSiphandler::OnSwitchBoardCallProcess  DTMF Digit %s",sobj->switchboardparam.DigitReceived.c_str());
	break;
	case EN_SWB_DIAL:
		CLog::Detail(THISMODULE,"SofiaSiphandler::OnSwitchBoardCallProcess : case EN_SWB_DIAL: calling DialOut(sobj)");
	 DialOut(sobj);	
	return;
	case EN_SWB_CALLCONNECTED:
	break;
	case EN_SWB_DIALDEFAULT:
	break;
	case EN_SWB_CALLDISCONNECT:
	break;
	case EN_SWB_CALLDISCONNECTED:
	break;
	default:
		return;

}
	xGateCallObj *callobj = new xGateCallObj;
        callobj->xGateCallObjInit();
	callobj->callid = sobj->callid;
  	//callobj->cp = sobj->cp;
        callobj->sipeventtype = EN_SWB_EVENT_REQ;
        callobj->switchboardinfo.PlayFile = sobj->switchboardparam.PlayFile;
        callobj->switchboardinfo.DigitReceived = sobj->switchboardparam.DigitReceived;
        callobj->switchboardinfo.SwbCallEvent =  sobj->switchboardparam.SwbCallEvent;
//	memcpy(&callobj->switchboardinfo, &sobj->switchboardparam,sizeof(sobj->switchboardparam));
	PostMessageToProcessor(callobj);
        sobj->switchboardparam.PlayFile = "";
	sobj->switchboardparam.DigitReceived = "";



}
/**/
RETCALLBACK SofiaSiphandler::SofiaCallBack(nua_event_t   event,  
    int           status,  
    char const   *phrase,  
    nua_t       *nua,  
    nua_magic_t  *magic,  
    nua_handle_t *nh,  
    nua_hmagic_t *hmagic,  
    sip_t const  *sip,  
    tagi_t        tags[]){
  // future task move this to seperate function for modulaurity

  CLog::Detail(THISMODULE,"SofiaSiphandler::SofiaCallBack(Event: %s status: %d Des: %s)",nua_event_name(event),status,phrase);
  //  printf("Sofia Event %s Des %s \n",nua_event_name(event),phrase);
  switch(event){
    // Error & Status Handling Event Function

    case nua_i_active:
      break;
    case nua_i_error:
      CLog::Error(THISMODULE,"SofiaSiphandler::SofiaCallBack(Event: %s status: %d Des: %s)",nua_event_name(event),status,phrase);
      break;
    case nua_i_fork :
      break;
    case nua_i_media_error :
      break;
    case nua_i_subscription :
      break;
    case nua_i_state :
      ((SofiaSiphandler*)magic)->OnStateChange(status,phrase,nua,magic,nh,hmagic,sip,tags);
      break;
    case nua_i_terminated:
      break;
      //................
      // SIP Request Event Handler Function
    case nua_i_ack :
      break;
    case nua_i_bye :
      ((SofiaSiphandler*)magic)->OnByeRequest(status,phrase,nua,magic,nh,hmagic,sip,tags);
      break;
    case nua_i_cancel :
      ((SofiaSiphandler*)magic)->OnInviteCancel(status,phrase,nua,magic,nh,hmagic,sip,tags);
      break;
    case nua_i_chat :
      break;
    case nua_i_info :
	((SofiaSiphandler*)magic)->OnInfoRequest(status,phrase,nua,magic,nh,hmagic,sip,tags);
      break;
    case nua_i_invite :
      CLog::Detail(THISMODULE, "ippbx-multithreaded : case nua_i_invite : ");
      ((SofiaSiphandler*)magic)->OnInviteRequest(status,phrase,nua,magic,nh,hmagic,sip,tags);
      break;
    case nua_i_message :
      //          OnMessageRequest();
      break;
    case nua_i_method :
      break;
    case nua_i_notify :
      break;
    case nua_i_options :
      break;
    case nua_i_prack :
      break;
    case nua_i_publish :
      break;
    case nua_i_refer :
      break;
    case nua_i_register :
      ((SofiaSiphandler*)magic)->OnRegistrationRequest(status,phrase,nua,magic,nh,hmagic,sip,tags);
      break;
    case nua_i_subscribe :
      break;
    case nua_i_update:
      break;
      //--------------------
      //  Response Event Handler Function 
    case nua_r_get_params:
      break;
    case nua_r_notifier :
      break;
    case nua_r_shutdown :
      break;
    case nua_r_terminate:
      break;
      //-----------------------
      // SIP Response Event Handler Function
    case nua_r_bye:
      break; 
    case nua_r_cancel:
      break;  
    case nua_r_info:
      break;  
    case nua_r_invite:

      ((SofiaSiphandler*)magic)->OnRequestResponse(status,phrase,nua,magic,nh,hmagic,sip,tags);
      break;  
    case nua_r_message:
      break;  
    case nua_r_notify:
      break;  
    case nua_r_options:
      break;  
    case nua_r_prack:
      break;  
    case nua_r_publish:
      break;  
    case nua_r_refer:
      break;  
    case nua_r_register:
      break;  
    case nua_r_subscribe:
      break;  
    case nua_r_unpublish:
      break;  
    case nua_r_unregister:
      break;  
    case nua_r_unsubscribe:
      break;  
    case nua_r_update:
      break; 
    default: //An unknown event can always be handled in the event callback
      CLog::Warning(THISMODULE,"SofiaSiphandler::SofiaCallBack UNKOWN EVENT");
      if(status < 200 && nua_event_is_incoming_request(event)){
        nua_respond(nh,SIP_501_NOT_IMPLEMENTED, NUTAG_WITH_THIS(nua), TAG_END());
        if(hmagic == NULL)
          nua_handle_destroy(nh);
      }
      break;
  }
}
/**/
void SofiaSiphandler::SofiaRootStep(nua_t* sua_handle,su_root_t* nuaRoot){
  if(sua_handle)
    su_root_step(nuaRoot,0);
}
/**/
void SofiaSiphandler::SofiaSendBye(nua_handle_t *nh){
  nua_bye(nh,TAG_END());
}

void SofiaSiphandler::OnInfoRequest(int status,char const *phrase,nua_t *nua,\
    nua_magic_t  *magic,nua_handle_t *nh,nua_hmagic_t *hmagic,sip_t const  *sip,
    tagi_t        tags[]){

        if(sip && sip->sip_payload && sip->sip_payload->pl_data)
        {
                xGateSofiaobj *sofiaobj = NULL;
                if(hmagic){
                        sofiaobj = (xGateSofiaobj*)hmagic;

                if ((sofiaobj->cp._isSwitchBoardCall) && (sofiaobj->SofiaLegB->cp.inband_dtmf_method == false))
                {
			sofiaobj->cp.sipinfo_method = true;
			sofiaobj->SofiaLegB->cp.sipinfo_method = true;
                        CLog::Detail(THISMODULE, "SofiaSiphandler::sipinfo : cp._isSwitchBoardCall == true; business-process");

                        //callobj->cp.dtmf_digits.assign(sip->sip_payload->pl_data, strlen(sip->sip_payload->pl_data));
			char *token;
			int count = 0; 
			while(token = strtok_r(sip->sip_payload->pl_data,"=\r\n",&sip->sip_payload->pl_data)){
//			cout <<"DTMF" << token << endl;
			switch(count){
			 case 0:
                         break;
			 case 1: // Signal digit
			   if(sofiaobj->switchboardparam.SwbCallEvent == EN_SWB_GETDTMF){
			//   if(strlen(sofiaobj->switchboardparam.DigitReceived.c_str()) < sofiaobj->switchboardparam.MaxDigit)
			if(sofiaobj->switchboardparam.DigitReceived.compare("$$$") == 0)
			   sofiaobj->switchboardparam.DigitReceived = "";
			   ////if((strstr(token,"11") == NULL) || (strstr(token,"#") == NULL)) {
			   if(strstr(token,"11") == NULL) {
			   if(strlen(sofiaobj->switchboardparam.DigitReceived.c_str()) < sofiaobj->switchboardparam.MaxDigit)
                             sofiaobj->switchboardparam.DigitReceived +=  token;
				if(strlen(sofiaobj->switchboardparam.DigitReceived.c_str()) ==  1)
				   {
                        		CLog::Detail(THISMODULE, "SofiaSiphandler::sipinfo : DigitReceived == 1; stop playing background file...");
					sofiaobj->cp.PbState = EN_XGATE_PB_STOP;
          				sofiaobj->cp.csfilename =  "";
          				sofiaobj->cp.Legid = 1; //TODO: stop rbt for origination leg
          				RequestForMedia(sofiaobj, EN_MEDIA_UPDATE);
				   } 
			   }else	

			    {
				if (strlen(sofiaobj->switchboardparam.DigitReceived.c_str()) > 0)
				{
			     		sofiaobj->switchboardparam.SwbCallEvent = EN_SWB_GETDTMF_COMPLET;
			     		OnSwitchBoardCallProcess(sofiaobj);
				}
			   }
			 }
//			  sofiaobj->switchboardparam.DigitReceived =  atoi(token);
			 break;
		 	 case 2:
 			 break;
			 case 3:
			 break;
				
			}
			count++;
			
			}
			

                        // Post message to processor
                        //PostMessageToProcessor(callobj);
                }
                else{
                        CLog::Detail(THISMODULE, "SofiaSiphandler::sipinfo : cp._isSwitchBoardCall == false; business-process");
                        //Forward Info
                        sip_payload_t *payload =  sip_payload_dup(&m_homeMemory,sip->sip_payload);
                        ForwardSipInfo(sofiaobj,payload);
                }
          }
        }
        else
                CLog::Detail(THISMODULE,"SofiaSiphandler::OnInfoRequest : SIP-Info message does NOT contain message-body");
}

xGateReturn SofiaSiphandler::ForwardSipInfo(xGateSofiaobj *sofiaobj,  sip_payload_t *payload){

 CLog::Detail(THISMODULE, "SofiaSiphandler::ForwardSipInfo(%s) Request", sofiaobj->callid.c_str());
 nua_info((nua_handle_t*)sofiaobj->SofiaLegB->sofianh,SIPTAG_CONTENT_TYPE_STR("application/dtmf-info"),SIPTAG_PAYLOAD(payload), TAG_END());
 //SofiaSendInfo(sofiaobj->SofiaLegB->sofianh);

return SUCCESS;
}

/**/
void SofiaSiphandler::OnInviteRequest(int status,char const *phrase,nua_t *nua,\  
    nua_magic_t  *magic,nua_handle_t *nh,nua_hmagic_t *hmagic,sip_t const  *sip,  
    tagi_t        tags[]){
  // Check the sip information is available if not return as bad request
  if(ValidateSipMessage(sip,SIPVALIDATE::FROM) == false || \
      //  ValidateSipMessage(sip,SIPVALIDATE::REQUEST)== false || 
      ValidateSipMessage(sip,SIPVALIDATE::CONTACT)== false || \
      ValidateSipMessage(sip,SIPVALIDATE::CALLID) == false){
    nua_respond(nh, 400,"Bad Request", TAG_END());
    CLog::Error(THISMODULE,"inside SofiaSiphandler::OnInviteRequest() Header validation failed; call_id = %s", sip->sip_call_id->i_id);
    return;
  }
  // Creating call id
  std::string callidstring = CreateUniqueCallid(sip->sip_from->a_url->url_user,\
      sip->sip_from->a_url->url_host,\
      sip->sip_from->a_tag,\
      sip->sip_call_id->i_id);
  callidstring += '\0';
  CLog::Detail(THISMODULE,"SofiaSiphandler::OnInviteRequest()Entry %s", callidstring.c_str());


  /**************
    std::string callidstring = sip->sip_call_id->i_id;
    callidstring += '\0';
    CLog::Detail(THISMODULE,"ippbx-multithreaded : inside SofiaSiphandler::OnInviteRequest() ; call_id = %s", sip->sip_call_id->i_id);
   **************/

  xGateSofiaobj *sofiaobj = NULL ;
  XGATESIPEVENT sipevent; 
  if(hmagic){
    sofiaobj = (xGateSofiaobj*)hmagic;


    CLog::Detail(THISMODULE,"SofiaSiphandler::OnInviteRequest() Re-Invite Handle %s", callidstring.c_str());
    switch(sofiaobj->callstate){
      case CallState::CS_Proceeding:
      case CallState::CS_Alerting:
        nua_respond(nh, 400,"Bad Request", TAG_END());
        CLog::Error(THISMODULE,"inside SofiaSiphandler::OnInviteRequest()call in progress %s", callidstring.c_str());
        return;
      case CallState::CS_Connecting:
      case CallState::CS_Connected:
        // Set the call state to CS_Suspendi
        sofiaobj->callstate =  CS_Suspended;
        sofiaobj->mediastate =  EN_MED_SUSPENDED;
        sofiaobj->SofiaLegB->mediastate = EN_MED_SUSPENDED;

        sipevent = EN_HOLDRESUME_REQ;
        break;
      case CallState::CS_Suspended:
        // Set The call state to CS_Conecting
        sofiaobj->callstate = CS_Connecting;
        sofiaobj->mediastate = EN_MED_RESUMED;
        sofiaobj->SofiaLegB->mediastate = EN_MED_RESUMED;
        sipevent = EN_HOLDRESUME_REQ;
        break;

      case CallState::CS_Initiating: // re-invite
      default: 
        sipevent  =  EN_REINVITE_REQ;	  
        break;
    }
    //SofiaReBindhandle((nua_handle_t*)sofiaobj->sofianh,nh,(nua_hmagic_t*)sofiaobj);
    // sofiaobj->sofianh = nh; // Explicitly doing 
    //sofiaobj->sofiamh = (void*)magic;
    // Creating new request

    xGateCallObj* callobj = new xGateCallObj;
    /*	if (sofiaobj->callstream == EN_OUTBOUND)
        {
        CreateCallobjparam(callobj,sofiaobj->callid,nh,sip,tags); // LegA having old callid.
        sofiaobj->SofiaLegB->callid = callidstring; // LegB having new callid.

        CreateSofiaobjparam(sofiaobj,callidstring,nh,magic,sip);
        }
        else
        CreateCallobjparam(callobj,callidstring,nh,sip,tags);*/
    sofiaobj->sipeventtype = sipevent;
    CreateCallobjparam(callobj,sofiaobj->callid,nh,sip,tags);
    // Post Message
    callobj->sipeventtype = sipevent;
    PostMessage(callobj,XGATEPOSTTYPE::EN_PROCESS);

    /****
      if (sofiaobj->callstream == EN_OUTBOUND)
      {
      CreateSofiaobjparam(sofiaobj,callidstring,nh,magic,sip);
    //sofiaobj->callid = callidstring;
    //InsertCallInfo(sofiaobj);
    }
     *****/
    return;
  }
  // Verify PSTN or APP Invite
  // check the domain name from auth list for 407 (APP to PSTN, DESK TO APP, DESK TO APP , APP to DESK ALL case )
  /*  if(sip->sip_from && sip->sip_from->a_url->url_host)
      if(CheckDomainForCallAuth(sip->sip_from->a_url->url_host) == true){
      CLog::Info(THISMODULE,"SofiaSiphandler::OnInviteRequest(%s)","CheckDomainForCallAuth -- True");
      if(AuthenticateSipSession(status,phrase,nua,magic,nh,hmagic,sip,tags)== true ){
      CreateSofiaobjparam(sofiaobj,callidstring,nh,magic,sip);
      }

      return ;
      }*/
  CreateSofiaobjparam(sofiaobj,callidstring,nh,magic,sip);
  CLog::Detail(THISMODULE,"SofiaSiphandler::OnInviteRequest ProcessInvite called %s", callidstring.c_str());
  ProcessInviteRequest(nh,sip,tags,callidstring);
}
/**/
void SofiaSiphandler::ProcessInviteRequest(nua_handle_t *nh,sip_t const  *sip,tagi_t tags[],std::string callidstring){


  CLog::Warning(THISMODULE,"SofiaSiphandler::ProcessInviteRequest(%s)",callidstring.c_str());

  // Create a New Call object Since it is new invite found
  xGateCallObj* callobj = new xGateCallObj;
  CreateCallobjparam(callobj,callidstring,nh,sip,tags);
  // Post Message^M
  callobj->sipeventtype = EN_INVITE_REQ;

  PostMessage(callobj,XGATEPOSTTYPE::EN_PROCESS);
}
/**/
void SofiaSiphandler::OnInviteCancel(int status,char const *phrase,nua_t *nua,\
    nua_magic_t  *magic,nua_handle_t *nh,nua_hmagic_t *hmagic,sip_t const  *sip,
    tagi_t        tags[]){

  CLog::Detail(THISMODULE,"SofiaSiphandler::OnInviteCancel(%d)",status);
 if(((xGateSofiaobj*)hmagic)->cp.isForkingenabled){
   CallCancleForking(((xGateSofiaobj*)hmagic));
  }
  else{
   nua_cancel((nua_handle_t*)((xGateSofiaobj*)hmagic)->SofiaLegB->sofianh,TAG_END());
  }
  xGateCallObj *callobj =  new xGateCallObj;
  callobj->xGateCallObjInit();
  callobj->callid = ((xGateSofiaobj*)hmagic)->callid;
  callobj->cp = ((xGateSofiaobj*)hmagic)->cp;
  callobj->sipeventtype = XGATESIPEVENT::EN_TERMINATED_REQ;

  PostMessage(callobj,XGATEPOSTTYPE::EN_PROCESS);
  ((SofiaSiphandler*)magic)->DeleteCallInfo((xGateSofiaobj*)hmagic);
  //((SofiaSiphandler*)magic)->DeleteSofiaObject((xGateSofiaobj*)hmagic);
}
xGateReturn SofiaSiphandler::CallCancleForking(xGateSofiaobj *sobj){
    std::vector<xGateSofiaobj*>::iterator itr = sobj->SofiaForkLeg.begin();
    for(itr; itr != sobj->SofiaForkLeg.end(); itr++) {
      xGateSofiaobj* forkSofiaObj = *itr;
      if((forkSofiaObj != NULL) && (forkSofiaObj->sofianh != NULL)) {
       if(forkSofiaObj->callstate > CS_Null && forkSofiaObj->callstate <= CS_Connected)
         nua_cancel((nua_handle_t*)forkSofiaObj->sofianh,TAG_END());
       if(forkSofiaObj->callstate > CS_Null)
          DeleteForkedSofiaObject(forkSofiaObj);
    
      }
    }

return SUCCESS;
}
