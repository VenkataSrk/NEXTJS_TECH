void SofiaSiphandler::RequestTermination(xGateSofiaobj *sobj){
  xGateCallObj *callobj =  new xGateCallObj;
  callobj->xGateCallObjInit();
  callobj->callid = sobj->callid;
  callobj->cp = sobj->cp;
  callobj->sipeventtype = XGATESIPEVENT::EN_TERMINATED_REQ;
  callobj->callstate = CS_Disconnected;
  PostMessage(callobj,EN_PROCESS);

}
/**/
void SofiaSiphandler::OnStateChange(int status,char const *phrase,nua_t *nua,\  
    nua_magic_t  *magic,nua_handle_t *nh,nua_hmagic_t *hmagic,sip_t const  *sip,  
    tagi_t        tags[]){

  if(!hmagic)
    return;
  xGateSofiaobj *sofiaobjsiphandle;
  sdp_session_t* lsdp = NULL;
  sdp_session_t* rsdp = NULL;

  sofiaobjsiphandle = (xGateSofiaobj*)hmagic;
  tl_gets(tags,NUTAG_CALLSTATE_REF(sofiaobjsiphandle->Sipcallstate),SOATAG_LOCAL_SDP_REF(lsdp),SOATAG_REMOTE_SDP_REF(rsdp),TAG_END());

  cout <<"\n SofiaSiphandler::OnStateChange " << nua_callstate_name(sofiaobjsiphandle->Sipcallstate) << endl;


  CLog::Detail(THISMODULE,"SofiaSiphandler::OnStateChange %s of %s",nua_callstate_name(sofiaobjsiphandle->Sipcallstate),\
      sofiaobjsiphandle->callid.c_str());
  //printf("State change %s callid %s\n",nua_callstate_name(sofiaobjsiphandle->Sipcallstate),sofiaobjsiphandle->callid.c_str());
  switch(sofiaobjsiphandle->Sipcallstate){
    case nua_callstate_init:

      break;
    case nua_callstate_authenticating:
      break;
    case nua_callstate_calling: // Invite Sent
      //Get lsdp
      if(lsdp){
        //duplicate the sdp structure to sofia object void pointer
        sdp_session_t* SofiaLocalsdp =	sdp_session_dup(&m_homeMemory,lsdp);
        sofiaobjsiphandle->lsdp = (void*)SofiaLocalsdp;
      }
      break;
    case nua_callstate_proceeding: // 18x Received (for outgoing invite response)
      {
        if(rsdp)
        {
          sdp_session_t* SofiaRemotesdp =  sdp_session_dup(&m_homeMemory,rsdp);
          sofiaobjsiphandle->rsdp = (void*)SofiaRemotesdp;
          if(sofiaobjsiphandle->SofiaLegB->isParallelForked == false)
          {
            SDPPharser(SofiaRemotesdp,sofiaobjsiphandle->SofiaSDPinfo);
            if(sofiaobjsiphandle->cp.csCallAgenttype == 2 || sofiaobjsiphandle->cp.csCallAgenttype == 0)
            {
              sofiaobjsiphandle->SofiaSDPinfo.outproto = "RTP";
            }
            if(sofiaobjsiphandle->cp.csCallAgenttype == 1)
            {
              sofiaobjsiphandle->SofiaSDPinfo.outproto = "DTLS";
            }
            sofiaobjsiphandle->cp.Legid = 2;
            sofiaobjsiphandle->mediastate = EN_MED_REQ;
            RequestForMedia(sofiaobjsiphandle);
          }
        }
        break;
      } 
    case nua_callstate_ready: // ACK send for 2xx received  or ACK received for 2xx sent
      {
        if(rsdp){
          if ((sofiaobjsiphandle->mediastate != EN_MED_SUSPENDED) && (sofiaobjsiphandle->mediastate != EN_MED_RESUMED)){
//	     if(sofiaobjsiphandle->cp.isForkingenabled != 1)
{	
            //duplicate the sdp structure to sofia object void pointer
            sdp_session_t* SofiaRemotesdp =  sdp_session_dup(&m_homeMemory,rsdp);
            sofiaobjsiphandle->rsdp = (void*)SofiaRemotesdp;
            SDPPharser(SofiaRemotesdp,sofiaobjsiphandle->SofiaSDPinfo);
            if(sofiaobjsiphandle->cp.csCallAgenttype == 2 || sofiaobjsiphandle->cp.csCallAgenttype == 0)
              sofiaobjsiphandle->SofiaSDPinfo.outproto = "RTP";
            if(sofiaobjsiphandle->cp.csCallAgenttype == 1)
              sofiaobjsiphandle->SofiaSDPinfo.outproto = "DTLS";

            sofiaobjsiphandle->cp.Legid = 2;
            sofiaobjsiphandle->mediastate = EN_MED_REQ;
            RequestForMedia(sofiaobjsiphandle);
	   }
          }
        }
        break;
      }
    case nua_callstate_completing: // 2xx Received (for outgoing invite response)
      CLog::Detail(THISMODULE,"SofiaSiphandler::OnStateChange : nua_callstate_completing / 2xx Received / ACK");
      if(rsdp){
        //duplicate the sdp structure to sofia object void pointer
        sdp_session_t* SofiaRemotesdp =  sdp_session_dup(&m_homeMemory,rsdp);
        sofiaobjsiphandle->rsdp = (void*)SofiaRemotesdp;
        sofiaobjsiphandle->SofiaSDPinfo.outproto = GetRtpPortType(sofiaobjsiphandle);

        /* if(sofiaobjsiphandle->cp.csCallAgenttype == 2 || sofiaobjsiphandle->cp.csCallAgenttype == 0)
           sofiaobjsiphandle->SofiaSDPinfo.outproto = "RTP";
           if(sofiaobjsiphandle->cp.csCallAgenttype == 1 || sofiaobjsiphandle->cp.csCallAgenttype == 3)
           sofiaobjsiphandle->SofiaSDPinfo.outproto = "DTLS";*/
        SDPPharser(SofiaRemotesdp,sofiaobjsiphandle->SofiaSDPinfo);
        sofiaobjsiphandle->cp.Legid = 2;
        sofiaobjsiphandle->mediastate = EN_MED_REQ;
        RequestForMedia(sofiaobjsiphandle);
      }
      break;
    case nua_callstate_received: // Invite Received (incoming call)
      CLog::Detail(THISMODULE,"SofiaSiphandler::OnStateChange : Invite Received (incoming call)");
      if(rsdp){
        //duplicate the sdp structure to sofia object void pointer
        sdp_session_t* SofiaRemotesdp =  sdp_session_dup(&m_homeMemory,rsdp);
        sofiaobjsiphandle->rsdp = (void*)SofiaRemotesdp;
        SDPPharser(SofiaRemotesdp,sofiaobjsiphandle->SofiaSDPinfo);
#if 0 // Yogesh Changes not requried commet by Yadav
	sofiaobjsiphandle->cp.inband_dtmf_method = false;
        sofiaobjsiphandle->SofiaLegB->cp.inband_dtmf_method = false;

	for (int index = 0; (sofiaobjsiphandle->SofiaSDPinfo.audiocodec[index].name.length() > 0); index++)
	{
	    CLog::Detail(THISMODULE,"SofiaSiphandler::OnStateChange : sofiaobjsiphandle->SofiaSDPinfo.audiocodec[index].name = %s",sofiaobjsiphandle->SofiaSDPinfo.audiocodec[index].name.c_str());
	    CLog::Detail(THISMODULE,"SofiaSiphandler::OnStateChange : sofiaobjsiphandle->SofiaSDPinfo.audiocodec[index].payloadtype = %u",sofiaobjsiphandle->SofiaSDPinfo.audiocodec[index].payloadtype);
	    if (!(strcmp(sofiaobjsiphandle->SofiaSDPinfo.audiocodec[index].name.c_str(), RTP_TELEPHONE_EVENT_STR)) &&
		(sofiaobjsiphandle->SofiaSDPinfo.audiocodec[index].payloadtype == RTP_PAYLOADTYPE_101))
		{
      			CLog::Detail(THISMODULE,"SofiaSiphandler::OnStateChange : telephone-event == true AND...");
      			CLog::Detail(THISMODULE,"SofiaSiphandler::OnStateChange : payloadtype == 101");
			// comment-out 2 lines of code below -if want to test sip-info using any Aastra-phone.
			sofiaobjsiphandle->cp.inband_dtmf_method = true;
                        sofiaobjsiphandle->SofiaLegB->cp.inband_dtmf_method = true;
			break;
		}
	}
#endif
      }
      break;
    case nua_callstate_early: // 18x sent with/without  sdp (for incoming call)
      break;
    case nua_callstate_completed:  //2xx sent (for incoming call)
      break;
      //          case nua_callstate_ready: // ACK send for 2xx received  or ACK received for 2xx sent
      //                                                      break;
      // On this event delete the handle and Sipobject alone no  need to remove from map it is already done 
    case nua_callstate_terminating: // BYE send 
      break;
    case nua_callstate_terminated: // ACK send for Bye Request
      CLog::Detail(THISMODULE,"SofiaSiphandler::OnStateChange case nua_callstate_terminated ****");
     // DeleteCallInfo(sofiaobjsiphandle);
      // DeleteSofiaObject(sofiaobjsiphandle);
      if(sofiaobjsiphandle->cp.isForkingenabled)
        DeleteForkedSofiaObject(sofiaobjsiphandle); 
      else{
       DeleteCallInfo(sofiaobjsiphandle);
       DeleteSofiaObject(sofiaobjsiphandle);
      }
      //sofiaobjsiphandle->DeleteAll();
           /*	SofiaBindhandle(nh, NULL);
          nua_handle_destroy(nh);
          if(sofiaobjsiphandle){
          sofiaobjsiphandle->DeleteAll();
          delete sofiaobjsiphandle;
          }	*/
      break;
    default:
      break;
  }

}
/**/
xGateSofiaobj*  SofiaSiphandler::GetProcessEvent(){

  xGateSofiaobj *sobj = NULL;
  xGateCallState *callstateobj;

  try{
    if((callstateobj = ReadFromReceiver()) != NULL){

      if(m_incomingCallHashTable.find(callstateobj->callid.c_str(),sobj) != -1){
        // sobj->callstate = callstateobj->callstate;
        // sobj->cp = callstateobj->cp;
        //sobj->sipeventtype = callstateobj->sipeventtype;
        ((SofiaSiphandler*)sobj->sofiamh)->OnProcessEvent(sobj,callstateobj);
        CLog::Warning("SofiaSiphandler", "GetProcessEvent  %s" ,callstateobj->callid.c_str());    
      }
      if(callstateobj)
        delete callstateobj;
    }
  }catch(...){
    CLog::Warning("SofiaSiphandler", "SetCallState- Exception ");
    return NULL;
  }
  return sobj;
}
/**/
void SofiaSiphandler::OnMessageRequest(){

}
/**/
void SofiaSiphandler::OnRegistrationRequest(int status,char const *phrase,nua_t *nua,\
    nua_magic_t  *magic,nua_handle_t *nh,nua_hmagic_t *hmagic,sip_t const  *sip,
    tagi_t        tags[]){

  CLog::Detail("SofiaSiphandler", " OnRegistrationRequest");
  //Validating From header
  //Validating To Header
  //Validating Contact Header
  if(ValidateSipMessage(sip,SIPVALIDATE::FROM) == false || \
      ValidateSipMessage(sip,SIPVALIDATE::TO)== false || \
      ValidateSipMessage(sip,SIPVALIDATE::CONTACT)== false || \
      ValidateSipMessage(sip,SIPVALIDATE::CALLID) == false){
    nua_respond(nh, 400,"Bad Request", TAG_END());

    return;
  }
  // Create the Registration object to post to Registration Manager 
  xGateSofiaSipRegobj *sipregobj = (xGateSofiaSipRegobj*)hmagic;
  //static xGateSofiaSipRegobj *sipregobj = NULL;
  if(!sipregobj){
    sipregobj = new xGateSofiaSipRegobj();
    CreateSofiaRegobj(*sipregobj,sip);

  }
  sipregobj->Reghandle = (void*) nh;
  sipregobj->sofiamh = (void*)magic; 

  // Save  the Registration Event help in reply Since REGISTRATION is not a full dialogi 
  // sip stack does not retain the handle on out of scope
  nua_saved_event_t *RegEvent = new nua_saved_event_t;
  nua_save_event(m_nuaHandle,RegEvent);
  sipregobj->sofiahmsg  = (void*)RegEvent;
  //msg_dup(nua_current_request(m_nuaHandle));
  SofiaBindhandle(nh,(nua_hmagic_t*)sipregobj);
  //printf(" Event Occured %s\n",sipregobj->callid.c_str());
  // Post the Message to DB Manager
  if(RegistarResponse(sipregobj) == SUCCESS){
    xGateSipMsgBlock *pSipRegMsg = new xGateSipMsgBlock(EN_XGATE_MSG_SIPREG_IN);
    pSipRegMsg->m_sipregobj = sipregobj;
    PostMessage(pSipRegMsg,XGATEPOSTTYPE::EN_DBMANAGER);
  }
}
xGateReturn SofiaSiphandler:: RegistarResponse(xGateSofiaSipRegobj *regobj){
  CLog::Detail("SofiaSiphandler", "RegistarReponse(%s)",regobj->callid.c_str());
  xGateReturn ret = SUCCESS;
  sip_t *sip = (sip_t*)regobj->regsip;
  nua_handle_t *nh = (nua_handle_t *)regobj->Reghandle;
  switch(regobj->Regevent){
    case EN_VALIDATE:{
                       char contact_uri[500];
                       sprintf(contact_uri,"<sip:%s@%s:%s;%s>",sip->sip_from->a_url->url_user,sip->sip_contact->m_url->url_host,\
                           sip->sip_contact->m_url->url_port,sip->sip_contact->m_url->url_params);
                       nua_respond(nh,SIP_100_TRYING,SIPTAG_CONTACT_STR(contact_uri),\
                           SIPTAG_DATE(sip->sip_date),NUTAG_WITH(nua_saved_event_request((nua_saved_event_t const*)regobj->sofiahmsg)),NUTAG_M_PARAMS(sip->sip_contact->m_url->url_params),TAG_END());
                     }
                     break;
    case EN_GETUSRPWD:
                     CLog::Detail("SofiaSiphandler", "RegistarReponse(%s)-- Get User Name Password for verification",regobj->callid.c_str());
                     break;	
    case EN_REGISTER:
    case EN_DEREGISTER:
                     if(VerifyAuthorisationResponce(sip,regobj,"REGISTER") == false){
                       ret = FAIL;
                       CLog::Detail("SofiaSiphandler", "RegistarReponse(%s)-- Auth Failed",regobj->callid.c_str());
                     }else{  // On Success verfication send 200 ok
                       xGateSipMsgBlock *pSipRegMsg = new xGateSipMsgBlock(EN_XGATE_MSG_SIPREG_IN);
                       pSipRegMsg->m_sipregobj = regobj;
                       PostMessage(pSipRegMsg,XGATEPOSTTYPE::EN_DBMANAGER);
                       break; // Break is required only success case
                     } 

    case EN_REG_FAILED:
    case EN_SEND401:{
                      char authwww[500] = "";
                      char buffer[1024] = "";
                      mod  = SofiaInitAuth(m_root);
                      if(mod){

                        auth_generate_digest_nonce (mod,buffer,1024,false,msg_now());

                        //char buffer[1024] ="\0" ;
                        //sprintf(buffer,"%s",CreateDigiestNonce().c_str());
                        //std::string buffer = CreateDigiestNonce();	
                        //  sprintf(authwww," Digest realm=\"%s\",qop=\"auth\",nonce=\"%s\",opaque=\"%s\",stale=FALSE,algorithm=\"MD5\"",\
                        //sip->sip_contact->m_url->url_host,buffer,"");
                        //  sip->sip_to->a_url->url_host,buffer,"");
                        sprintf(authwww," Digest realm=\"%s\",nonce=\"%s\"",\
                            sip->sip_to->a_url->url_host,buffer);

                        nua_respond(nh,401,"Unauthorized",SIPTAG_WWW_AUTHENTICATE_STR(authwww),\
                            SIPTAG_DATE(sip->sip_date),NUTAG_WITH_THIS(m_nuaHandle),NUTAG_WITH_SAVED((nua_saved_event_t const*)regobj->sofiahmsg),NUTAG_M_PARAMS(sip->sip_contact->m_url->url_params),TAG_END());
                        nua_destroy_event((nua_saved_event_t*)regobj->sofiahmsg);
                      }
                    }
                    if(regobj) delete regobj;
                    break;

                    break;
    case EN_REG_SUCESS:{
                         char contact_uri[500];
                         sprintf(contact_uri,"<sip:%s@%s:%s;%s>;received=\"sip:%s:%s\"",sip->sip_contact->m_url->url_user,sip->sip_contact->m_url->url_host,\
                             sip->sip_contact->m_url->url_port,sip->sip_contact->m_url->url_params,sip->sip_contact->m_url->url_host,sip->sip_contact->m_url->url_port,sip->sip_contact->m_url->url_host,sip->sip_contact->m_url->url_port);
                         //         sprintf(contact_uri,"<sip:%s@%s:%s;%s>;expires=3600;received=\"sip:%s:%s\"",sip->sip_from->a_url->url_user,sip->sip_to->a_url->url_host,\
                         sip->sip_to->a_url->url_port,sip->sip_contact->m_url->url_params,sip->sip_contact->m_url->url_host,sip->sip_contact->m_url->url_port,sip->sip_contact->m_url->url_host,sip->sip_contact->m_url->url_port);
                         nua_respond(nh,200,"OK", SIPTAG_CONTACT_STR(contact_uri),SIPTAG_DATE(sip->sip_date),NUTAG_WITH_THIS(m_nuaHandle),\
                             NUTAG_WITH_SAVED((nua_saved_event_t const*)regobj->sofiahmsg),NUTAG_M_PARAMS(sip->sip_contact->m_url->url_params),TAG_END());
                         nua_destroy_event((nua_saved_event_t*)regobj->sofiahmsg);
                       }
                       if(regobj) delete regobj;
                       break;
    case EN_AUTHCALL:{ // Event will handle invite auth
                       if(VerifyAuthorisationResponce(sip,regobj,"INVITE") == false){
                         CLog::Detail("SofiaSiphandler", "RegistarReponse(%s)- Call/Session Auth Verification failed",regobj->callid.c_str());
                         ret = FAIL;
                       }else{

                         std::string callidstring = CreateUniqueCallid(sip->sip_from->a_url->url_user,\
                             sip->sip_from->a_url->url_host,\
                             sip->sip_from->a_tag,\
                             sip->sip_call_id->i_id);
                         CLog::Detail("SofiaSiphandler", "RegistarReponse(%s)- Call/Session Verification Successed",callidstring.c_str());
                         ProcessInviteRequest((nua_handle_t*)regobj->Reghandle,sip,(tagi_t*)regobj->siptags,callidstring);
                         if(regobj) delete regobj;	
                         break;	
                       }

                     }
    case EN_SEND407:{  
                      char proxyauth[500] = "";
                      char buffer[1024] = "";
                      mod  = SofiaInitAuth(m_root);
                      if(mod){

                        auth_generate_digest_nonce (mod,buffer,1024,false,msg_now());

                        /*                        sprintf(proxyauth," Digest realm=\"%s\",qop=\"auth\",nonce=\"%s\",opaque=\"%s\",stale=FALSE,algorithm=\"MD5\"",\
                                                  sip->sip_contact->m_url->url_host,buffer,"");*/
                        sprintf(proxyauth," Digest realm=\"%s\",nonce=\"%s\"",\
                            sip->sip_contact->m_url->url_host,buffer);

                        nua_respond(nh,407,"Proxy Authentication Required",SIPTAG_PROXY_AUTHENTICATE_STR(proxyauth),\
                            SIPTAG_DATE(sip->sip_date),TAG_END());
                        CLog::Detail("SofiaSiphandler", "RegistarReponse(%s)- 407 Proxy Authentication Required sent",regobj->callid.c_str());
                      }
                      if(regobj) delete regobj;
                    }
                    break;

    default:
                    break;
  }
  return ret;
}
bool SofiaSiphandler::AuthenticateSipSession(int status,char const *phrase,nua_t *nua,\
    nua_magic_t  *magic,nua_handle_t *nh,nua_hmagic_t *hmagic,sip_t const  *sip,
    tagi_t        tags[]){

  xGateSofiaSipRegobj *sipregobj = new xGateSofiaSipRegobj();
  CreateSofiaRegobj(*sipregobj,sip);
  CLog::Detail("SofiaSiphandler","AuthenticateSipSession(%s)",sipregobj->callid.c_str());
  sipregobj->Reghandle = (void*) nh;
  sipregobj->sofiamh = (void*)magic;
  sipregobj->siptags = (void*)tags;
  bool ret = false;

  if(sip->sip_proxy_authorization){ // Request has auth paramaters

    //Post message to DB thread  

    sipregobj->Regevent = EN_AUTHCALL;  
    xGateSipMsgBlock *pSipRegMsg = new xGateSipMsgBlock(EN_XGATE_MSG_SIPREG_IN);
    pSipRegMsg->m_sipregobj = sipregobj;
    PostMessage(pSipRegMsg,XGATEPOSTTYPE::EN_DBMANAGER);
    CLog::Detail("SofiaSiphandler","AuthenticateSipSession(%s) - Verification Request to DB Manager",sipregobj->callid.c_str());
    ret = true;
  }else{
    // Send 407 
    sipregobj->Regevent = EN_SEND407;
    RegistarResponse(sipregobj); 

  }
  return ret;
}
bool SofiaSiphandler::VerifyAuthorisationResponce(sip_t const *sip, xGateSofiaSipRegobj *regobj,char requestmethod[15]="REGISTER"){

  CLog::Detail("SofiaSiphandler", "VerifyAuthorisationResponce(%s)",regobj->callid.c_str());

  auth_response_t ar[1] = {{ 0 }};
  char const *md5 = NULL, *md5sess = NULL, *sha1 = NULL,
       *qop_auth = NULL, *qop_auth_int = NULL;
  struct msg_auth_s *rr  = NULL;
  if(strstr(requestmethod,"INVITE")){
    rr = sip->sip_proxy_authorization;
  }else{
    rr = sip->sip_authorization;
  }
  if (rr){
    auth_get_params(&m_homeMemory, rr->au_params,
        "username=", &ar->ar_username,
        "realm=", &ar->ar_realm,
        "nonce=", &ar->ar_nonce,
        "uri=", &ar->ar_uri,
        "response=", &ar->ar_response,
        "algorithm=", &ar->ar_algorithm,
        "opaque=", &ar->ar_opaque,
        "cnonce=", &ar->ar_cnonce,
        "qop=", &ar->ar_qop,
        "nc=", &ar->ar_nc,
        "algorithm=md5", &md5,
        "algorithm=md5-sess", &md5sess,
        "algorithm=sha1", &sha1,
        "qop=auth", &qop_auth,
        "qop=auth-int", &qop_auth_int,
        NULL);
    //    ar->ar_auth = 1;  // TODO not required for aastrat phone it isoptional all other phone
    //    ar->ar_qop = "auth";
    // Creating HA1 hash
    auth_hexmd5_t ha1;
    auth_digest_ha1(ha1,ar->ar_username,ar->ar_realm,regobj->password.c_str());

    // Creating  HA2 and responce 
    auth_hexmd5_t Regresponce;
    auth_digest_response(ar,Regresponce,ha1,requestmethod,NULL,0);
    CLog::Detail(THISMODULE, "\n**SofiaSiphandler VerifyAuthorisationResponceUsername = (%s)&& password = (%s)", ar->ar_username,regobj->password.c_str());
    CLog::Detail("SofiaSiphandler VerifyAuthorisationResponce(%s)Create Hash %s -- Received Hash %s ",regobj->callid.c_str(),Regresponce,ar->ar_response);
    if(strstr(ar->ar_response, Regresponce) != NULL){
      return true;
    }
  }
  return false;

}
std::string SofiaSiphandler::CreateDigiestNonce(){
  std::string retnonce = "";
  //auth_mod_t *
  mod  = SofiaInitAuth(m_root);
  if(mod){
    char buffer[1024] = "";
    auth_generate_digest_nonce (mod,buffer,1024,false,msg_now());
    retnonce = buffer;
    //printf(" Nonce value %s", buffer);
  }       
}
void SofiaSiphandler::GetProcessRegisterEvent(){
  xGateSofiaSipRegobj *RegQEvt = NULL;
  if((RegQEvt = PopFromReceiver()) != NULL){
    ((SofiaSiphandler*)RegQEvt->sofiamh)->RegistarResponse(RegQEvt);
  }

}

/**/
void SofiaSiphandler::parsestringtokens(std::string input, char delimit, std::string &token1, std::string &token2 ){
std:string::size_type pos = input.find(delimit);

    if( pos == std::string::npos){
      token1 = input;
      token2 = "";
    }
    else{
      token1 =input.substr(0,pos);
      token2 = input.substr(pos+1);
    }
}
/**/
std::string SofiaSiphandler::ValidateDialParam(const char *pVal, SIPVALIDATE header,XGATESIPKEY key,CallParameter cp){
  std::string ret = "";
  std::string temp = "";  // TODO Need to removed after audit/review with current logic
  if(ValidateSipMsgPointer(pVal))
  {
    ret = pVal;

  } else
    //on url is void get form callparameter
    switch (header){
      case FROM:
        {
          cp.cnCalling.erase(std::remove(cp.cnCalling.begin(),cp.cnCalling.end(),'\"'),cp.cnCalling.end());
          {
            switch(key){
              case EN_USER:
                parsestringtokens(cp.cnCalling,':',ret,temp); 
                break;
              case EN_PWD:
                parsestringtokens(cp.cnCalling,':',temp,ret);
                break;
              case EN_HOST:
                parsestringtokens(cp.csaCalling,':',ret,temp); 
                break;
              case EN_PORT:
                parsestringtokens(cp.csaCalling,':',temp,ret);
                if(ret.empty())
                  ret = "5060";
                break;
              case EN_SCHEMA:
                ret = "sip";
                break;
              case EN_PARAM:
                ret="";
                break;
              default:
                ret = "";
                break;
            }
          }

        }
        break;
      case TO:
        {
          switch(key){
            case EN_USER:

              ParseUserPassword(cp.cnCalled,ret,temp); 
              break;
            case EN_PWD:
              ParseUserPassword(cp.cnCalled,temp,ret);
              break;
            case EN_HOST:
              parsestringtokens(cp.csaCalled,':',ret,temp); 
              break;
            case EN_PORT:
              parsestringtokens(cp.csaCalled,':',temp,ret);
              if(ret.empty())
                ret = "5060";
              break;
            case EN_SCHEMA:
              ret = "sip";
              break;
            case EN_PARAM:
              ret="";
              break;
            default:
              ret = "";
              break;
          }
        }
        break;
      case CONTACT:
        {
          cp.cnCalling.erase(std::remove(cp.cnCalling.begin(),cp.cnCalling.end(),'\"'),cp.cnCalling.end());
          switch(key){
            case EN_USER:
              parsestringtokens(cp.cnCalling,':',ret,temp); 
              break;
            case EN_PWD:
              parsestringtokens(cp.cnCalling,':',temp,ret);
              break;
            case EN_HOST:
              parsestringtokens(cp.csaCalling,':',ret,temp); 
              break;
            case EN_PORT:
              parsestringtokens(cp.csaCalling,':',temp,ret);
              if(ret.empty())
                ret = "5060";

              break;
            case EN_SCHEMA:
              ret = "sip";
              break;
            case EN_PARAM:
              ret="";
              break;
            default:
              ret = "";
              break;
          }
        }
        break;
      case PAI:
        {
          switch(key){
            case EN_USER:
              parsestringtokens(cp.cnCalling,':',ret,temp); 
              break;
            case EN_PWD:
              parsestringtokens(cp.cnCalling,':',temp,ret);
              break;
            case EN_HOST:
              // parsestringtokens(cp.csaCalling,':',ret,temp); 
              //parsestringtokens(xGateUtil::GetLocalIPAddress(),':',ret,temp); 
              //parsestringtokens(xGateUtil::getLocalIpAddr(),':',ret,temp); 
              parsestringtokens(XGSIP_HOST(),':',ret,temp); 
              break;
            case EN_PORT:
              parsestringtokens(cp.csaCalling,':',temp,ret);
              if(ret.empty())
                ret = "5060";
              break;
            case EN_SCHEMA:
              ret = "sip";
              break;
            case EN_PARAM:
              ret="";
              break;
            default:
              ret = "";
              break;
          }
        }
        break;
      case CALLID:
        break;
        break;
      case VIA:
      default:
        break;
    }
  return ret;

}
/**/
bool SofiaSiphandler::ValidateSipMessage(sip_t const *sip,SIPVALIDATE header){
  if(sip){
    switch(header){
      case SIPVALIDATE::FROM:

        if(!sip->sip_from || \
            !sip->sip_from->a_url->url_user || !sip->sip_from->a_url->url_host ||\
            !sip->sip_from->a_tag){
          CLog::Warning(THISMODULE,"SofiaSiphandler::ValidateSipMessage(%s)","Failed-Sip From Header Validation");
          return false;    
        }
        break;
      case SIPVALIDATE::REQUEST:
        if( !sip->sip_request || \
            !sip->sip_request->rq_url->url_user || !sip->sip_request->rq_url->url_host || \
            !sip->sip_request->rq_url->url_port){
          CLog::Warning(THISMODULE,"SofiaSiphandler::ValidateSipMessage(%s)","Failed-Sip Request Header Validation");
          return false;
        }
        break;
      case SIPVALIDATE::CONTACT:
        if(!sip->sip_contact){
          CLog::Warning(THISMODULE,"SofiaSiphandler::ValidateSipMessage(%s)","Failed-Sip Contact Header Validation");
          return false;
        }
        break;
      case SIPVALIDATE::TO:
        if(!sip->sip_to || \
            !sip->sip_to->a_url->url_user || !sip->sip_to->a_url->url_host){
          CLog::Warning(THISMODULE,"SofiaSiphandler::ValidateSipMessage(%s)","Failed-Sip To Header Validation");
          return false; 
        }
        break;
      case SIPVALIDATE::TAG:
        break;
      case SIPVALIDATE::CALLID:
        if(!sip->sip_call_id ||\
            !sip->sip_call_id->i_id){
          CLog::Warning(THISMODULE,"SofiaSiphandler::ValidateSipMessage(%s)","Failed-Sip Callid Header Validation");
          return false; 
        }
        break;
      default:
        CLog::Warning(THISMODULE,"SofiaSiphandler::ValidateSipMessage(%s)","No Header option to check");
        return false;
        break;
    } //swicth case Header 
  } //Sip check point
  else{
    CLog::Warning(THISMODULE,"SofiaSiphandler::ValidateSipMessage(%s)","Failed-Sip Structure Validation");
    return false;
  }
  return true;

} // ValidateSipMessage


/**/
std::string SofiaSiphandler::FillHeader(url_t *url,CallParameter cp,SIPVALIDATE header){
  std::stringstream xgateSipheader ;
  if(url ==NULL){
    xgateSipheader << ValidateDialParam(NULL,header,XGATESIPKEY::EN_USER,cp)  ; //User
    xgateSipheader << "<" ;
    xgateSipheader << ValidateDialParam(NULL,header,XGATESIPKEY::EN_SCHEMA,cp) << ":" ;
    xgateSipheader << ValidateDialParam(NULL,header,XGATESIPKEY::EN_USER,cp) << "@" ;
    xgateSipheader << ValidateDialParam(NULL,header,XGATESIPKEY::EN_HOST,cp) << ":" ;
    xgateSipheader << ValidateDialParam(NULL,header,XGATESIPKEY::EN_PORT,cp);

  }else{

    xgateSipheader << ValidateDialParam(url->url_user,header,XGATESIPKEY::EN_USER,cp)  ; //User
    xgateSipheader << "<" ;
    xgateSipheader << ValidateDialParam(url->url_scheme,header,XGATESIPKEY::EN_SCHEMA,cp) << ":" ;
    xgateSipheader << ValidateDialParam(url->url_user,header,XGATESIPKEY::EN_USER,cp) << "@" ;
    xgateSipheader << ValidateDialParam(url->url_host,header,XGATESIPKEY::EN_HOST,cp)<< ":" ;
    xgateSipheader << ValidateDialParam(url->url_port,header,XGATESIPKEY::EN_PORT,cp);
  }
  switch (header){
    case FROM:
      xgateSipheader << ">";
      break;
    case TO:
      xgateSipheader << ">";


      break;
    case CONTACT:
      /*if(strstr(ValidateDialParam(url->url_params,header,XGATESIPKEY::EN_PARAM,cp).c_str(),"transport=tcp"))
        xgateSipheader << ";transport=tcp";
        xgateSipheader << ";" << ValidateDialParam(url->url_params,header,XGATESIPKEY::EN_PARAM,cp);*/
      if(strstr(ValidateDialParam(NULL,header,XGATESIPKEY::EN_PARAM,cp).c_str(),"transport=tcp"))
        xgateSipheader << ";transport=tcp";
      else
        xgateSipheader << ";transport=udp";
      /*xgateSipheader << ";" << ValidateDialParam(NULL,header,XGATESIPKEY::EN_PARAM,cp);*/
      xgateSipheader << ">";
      break;
    case PAI:
      xgateSipheader << ";user=phone";
      xgateSipheader << ">";
      break;
    case REQUEST:
      break;
    case TAG:
      break;
    case CALLID:
      break;
      break;
    case SUBJECT:
      break;
    case VIA:
    case CONTACTLEN :
      break;
    default:
      break;
  }



  return xgateSipheader.str();
}

