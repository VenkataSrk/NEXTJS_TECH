	sofiaobj->SofiaLegB->switchboardparam.SwbCallEvent = EN_SWB_NULL;
}

unsigned char hexToChar(const std::string &str) {
  short c = 0;

  if(!str.empty()) {
    std::istringstream in(str);

    in >> std::hex >> c;

    if(in.fail()) {
      //throw std::runtime_error("stream decode failure");
    }
  }
  return static_cast<unsigned char>(c);
}

String SipHeaderDecode(const String &toDecode) {
  std::ostringstream out;

  for(String::size_type i=0; i < toDecode.length(); ++i) {
    if(toDecode.at(i) == '%') {
      String str(toDecode.substr(i+1, 2));
      out << hexToChar(str);
      i += 2;
    } else {
      out << toDecode.at(i);
    }
  }

  return out.str();
}

String SipHeaderEncode(const String &value) {
  std::ostringstream escaped;
  escaped.fill('0');
  escaped << std::hex;

  for (String::const_iterator i = value.begin(), n = value.end(); i != n; ++i) {
    String::value_type c = (*i);

    // Keep alphanumeric and other accepted characters intact
    if (isalnum(c) || c == '-' || c == '_' || c == '.' || c == '~') {
      escaped << c;
      continue;
    }

    // Any other characters are percent-encoded
    escaped << '%' << std::setw(2) << int((unsigned char) c);
  }
  return escaped.str();
}


bool SofiaSiphandler::SetCallParameter(CallParameter &cp, sip_t const *sip, tagi_t tags[])
{
  // TODO:  Restructure the below code for clarity & best practices
  /* Here need to fill
     1. csaCalled
     2. cnCalled
     3. cntCalled
     4. cnpcalled

     1. csaCalling
     2. cnCalling
     3. cntCalling
     4. cnpcalling
     */

  char _temp[256];
  //Updating called paramater
  cp.csaCalled = "";
  // cp.csaCalled += sip->sip_request->rq_url->url_host;
  ////////cp.csaCalled += XGSIP_HOST();
  cp.csaCalled += sip->sip_request->rq_url->url_host;
  CLog::Detail(THISMODULE, "multithreaded-ippbx : cp.csaCalled = " , cp.csaCalled);
  cp.csaCalled += ':';
  //cp.csaCalled += sip->sip_request->rq_url->url_port;
  cp.csaCalled += XGSIPPORT;

  //TODO: Yoga, done for New-MGC PBX integration
  if(sip->sip_from->a_url)
  {
    if(StringExists(sip->sip_from->a_url->url_host))
    {
      //cp.routeAddr = sip->sip_request->rq_url->url_host;
      cp.routeAddr = sip->sip_from->a_url->url_host;
      cp.routeAddr += '\0';
      CLog::Detail(THISMODULE, "************IPPBX : SetCallParameter() : domainName: %s\n", cp.routeAddr.c_str());
    }
  }
  if (strlen(cp.cnCalled.c_str()) == 0)
  {
    CLog::Warning(THISMODULE, "************IPPBX : 4) cparam.cnCalled.c_str() == null\n");
    cp.cnCalled.erase();
    cp.cnCalled = sip->sip_to->a_url->url_user;
    cp.cnCalled += '\0';
    //cp.cnCalled += "@";
    //cp.cnCalled += sip->sip_to->a_url->url_host;
  }


  if(ValidateSipMsgPointer(sip->sip_request->rq_url->url_password)) {
    snprintf (_temp, sizeof(_temp), "%s:%s", 
        sip->sip_request->rq_url->url_user, 
        sip->sip_request->rq_url->url_password);
  } else{
    snprintf (_temp, sizeof(_temp), "%s", sip->sip_request->rq_url->url_user);
    cp.csCallAgenttype = 0;
    // Harded coded value 008 for APP TO PSTN call scenerio TODO Remove after testinifg
    if(sip->sip_user_agent){ 
      if(sip->sip_user_agent->g_string){
        cp.callingDeviceType = sip->sip_user_agent->g_string; // Added to support Peer to Peer check in PBX Yadav
        if(strstr(sip->sip_user_agent->g_string,"DCAPP"))
        {
          snprintf (_temp, sizeof(_temp), "0007%s", sip->sip_request->rq_url->url_user);
          cp.csCallingContact = sip->sip_contact->m_url->url_host;
          cp.csCallAgenttype = 1; //App call;
        }
        else if (strstr(sip->sip_user_agent->g_string,"VAPP")){
          snprintf (_temp, sizeof(_temp), "0002%s", sip->sip_request->rq_url->url_user);
          cp.csCallingContact = sip->sip_contact->m_url->url_host;
          cp.csCallAgenttype = 1; //App call;
        }
        else if(strstr(sip->sip_user_agent->g_string,"URAPP")){
          snprintf (_temp, sizeof(_temp), "%s", sip->sip_request->rq_url->url_user);
          cp.csCallingContact = sip->sip_contact->m_url->url_host;
          cp.csCallAgenttype = 1; //App call;
        }
        else if(strstr(sip->sip_user_agent->g_string,"URWEB")){
          cp.csCallAgenttype = 3;
        }
      }
    }
  }
  if (sip->sip_to->a_url->url_user) // To enable PSTN To APP 
    if(strstr(sip->sip_to->a_url->url_user,"DELAPP"))
      cp.csCallAgenttype = 2;

  if (ParseTelephoneNumber(_temp, cp.cnCalled, cp.cntCalled))
    cp.cnpCalled = CNP_ISDN;


  // check paid service for calling party
  // TODO Need to check required or any  hard code value need
  sip_p_asserted_identity_t * Paidurl=sip_p_asserted_identity(sip);

  if(Paidurl && Paidurl->paid_url){
    cp.csaCalling = "";
    cp.csaCalling += Paidurl->paid_url->url_host;
    if(Paidurl->paid_url->url_port){
      cp.csaCalling += ":";
      cp.csaCalling += Paidurl->paid_url->url_port;
    } 

    if(sip->sip_privacy){ // Only on privacy paid url are used
      if(ValidateSipMsgPointer(Paidurl->paid_url->url_password))
        snprintf (_temp, sizeof(_temp), "%s:%s", 
            Paidurl->paid_url->url_user, 
            Paidurl->paid_url->url_password);
      else
        snprintf (_temp, sizeof(_temp), "%s", Paidurl->paid_url->url_user);

      if(ParseTelephoneNumber(_temp,cp.cnCalling,cp.cntCalling))
        cp.cnpCalling = CNP_ISDN;
      cp.ccp=!strcmp(sip->sip_privacy->priv_values[0],"none") ? CCP_Allowed : CCP_Restricted;    
    }
    else{ // on privary not avaiable even on paid, update sip_from url info
      if(ValidateSipMsgPointer(sip->sip_from->a_url->url_password))
        snprintf (_temp, sizeof(_temp), "%s:%s", sip->sip_from->a_url->url_user, sip->sip_from->a_url->url_password);
      else
        snprintf (_temp, sizeof(_temp), "%s", sip->sip_from->a_url->url_user);

      if(ParseTelephoneNumber(_temp,cp.cnCalling,cp.cntCalling))
        cp.cnpCalling = CNP_ISDN;
      cp.ccp = CCP_Allowed;    
    }
  }
  else{
    cp.csaCalling = "";
    cp.csaCalling += sip->sip_from->a_url->url_host; //TODO: We have enable this for live call
    if(sip->sip_from->a_url->url_port) {
      cp.csaCalling += ":";
      cp.csaCalling += sip->sip_from->a_url->url_port;
    }
    //cp.csaCalling = "10.22.2.82"; //TODO: Testing only, disabled for live call
    cp.cnpCalling = CNP_ISDN;
    cp.cntCalling = CNT_Unknown;
    cp.cnCalling = "";

    if(strcmp(sip->sip_from->a_url->url_user,"unavailable") == 0){
      cp.ccp = CCP_NotAvailable;
    }else if (strcmp(sip->sip_from->a_url->url_user,"anonymous") == 0){
      cp.ccp = CCP_Restricted;
    }else{
      char _temp[256];
      if(ValidateSipMsgPointer(sip->sip_from->a_url->url_password))
        snprintf (_temp, sizeof(_temp), "%s:%s", sip->sip_from->a_url->url_user, sip->sip_from->a_url->url_password);
      else
        snprintf (_temp, sizeof(_temp), "%s", sip->sip_from->a_url->url_user);
      if(ParseTelephoneNumber(_temp,cp.cnCalling,cp.cntCalling))
        cp.cnpCalling = CNP_ISDN;    

    }

  }

  // TODO: Need optimisation for below code yadav
  cp.cui="";
  cp.cpinfo="";
  sip_unknown_t* pUnknown=sip->sip_unknown;

  while(pUnknown)
  {
    if(!strcmp(pUnknown->un_name, XGATE_SOFIA_HEADER_USER_INFO))
      cp.cui=SipHeaderDecode(pUnknown->un_value);
    if(!strcmp(pUnknown->un_name, XGATE_SOFIA_HEADER_PRIVATE_INFO))
      cp.cpinfo=SipHeaderDecode(pUnknown->un_value);
    pUnknown=pUnknown->un_next;
  }

  return true;;
}


