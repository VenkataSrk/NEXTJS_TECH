          orgSofiaObj->noOfPeers--;
          itr = orgSofiaObj->SofiaForkLeg.erase(itr);
          break;
        }
      }
      ++itr;
    }
    SofiaSendAck(handle);
    SofiaSendBye(handle);
    CLog::Detail(THISMODULE,"SofiaSiphandler::OnRequestResponse(%d) disconncted to mapped call %d",status,__LINE__);
  }
}
