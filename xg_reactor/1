#ifndef _XGATE_BASE_MSG_H
#define _XGATE_BASE_MSG_H

//ace includes
#include <ace/Message_Block.h>

//local includes
#include "xGateDefine.h"
#include "IURModuleMsg.h"
#include "URDefines.h"

class xGateBaseMsg : public ACE_Message_Block,public IURModuleMsg
{
  public:
    xGateBaseMsg(MODULE_ID srcModuleId) :
      m_srcModuleId(srcModuleId),
      m_dstModuleId(UR_MODULE_UNKNOWN),
      m_uid(""),
      m_opcode(0){};
    virtual ~xGateBaseMsg(){};

    void setSrcModuleId(MODULE_ID moduleId)
    {
      m_srcModuleId = moduleId;
    }

    MODULE_ID getSrcModuleId() const
    {
      return m_srcModuleId;
    }

    void setDstModuleId(MODULE_ID moduleId)
    {
      m_dstModuleId = moduleId;
    }

    MODULE_ID getDstModuleId() const
    {
      return m_dstModuleId;
    }

    void setUid(string uid)
    {
      m_uid = uid;
    }

    string getUid() const
    {
      return m_uid;
    }

    void setOpCode(unsigned int opcode)
    {
      m_opcode = opcode;
    }

    unsigned int getOpCode() const
    {
      return m_opcode;
    }
  protected:
    xGateBaseMsg& operator=(const xGateBaseMsg&);

  private:
    // Not Implemented Methods
    xGateBaseMsg(void);
    xGateBaseMsg(const xGateBaseMsg&);

    string m_uid;
    unsigned int m_opcode;
    MODULE_ID m_srcModuleId;
    MODULE_ID m_dstModuleId;
};
#endif
