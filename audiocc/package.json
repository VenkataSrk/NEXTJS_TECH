{
  "name": "CCAAS-AUDIO-CC",
  "version": "1.0.0",
  "description": "This is Audio cc service",
  "main": "index.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=qa nodemon --watch './src/**/*.ts' --exec ts-node ./src/index.ts",
    "build": "tsc",
    "test": "jest --coverage",
    "test:watch": "npm run test -- --watchAll",
    ".": "cross-env NODE_ENV=qa nodemon ./src/index.ts",
    "stage": "cross-env NODE_ENV=stage nodemon ./src/index.ts",
    "start": "cross-env NODE_ENV=production ts-node ./src/index.ts",
    "start:prod": "node dist/src/index.js",
    "prebuild": "npm run lint",
    "prestart": "npm run build",
    "postinstall": "npm run build",
    "lint": "tslint -c tslint.json -p tsconfig.json --fix"
  },
  "keywords": [],
  "dependencies": {
    "@socket.io/redis-emitter": "4.1.1",
    "cross-env": "^10.0.0",
    "dotenv": "8.3.0",
    "fastify": "3.27.1",
    "fastify-plugin": "3.0.0",
    "ioredis": "^5.3.1",
    "log4js": "6.3.0",
    "moment": "2.29.1",
    "mssql": "7.3.0",
    "mysql": "^2.18.1",
    "redis": "3.1.0"
  },
  "devDependencies": {
    "@types/cors": "2.8.10",
    "@types/mssql": "^7.1.5",
    "@types/node": "12.20.18",
    "nodemon": "2.0.14",
    "ts-node": "8.10.2",
    "tslint": "^6.1.3",
    "tslint-config-airbnb": "^5.11.2",
    "tslint-config-prettier": "^1.18.0",
    "typescript": "^4.5.5"
  }
}