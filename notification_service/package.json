{
    "name": "ccaas-call",
    "version": "1.0.0",
    "description": "This is ccaas-call http rest service",
    "main": "index.js",
    "scripts": {
        "dev": "nodemon --watch './src/**/*.ts' --exec ts-node ./src/index.ts",
        "build": "tsc",
        "test": "jest --coverage",
        "test:watch": "npm run test -- --watchAll",
        ".": "nodemon ./src/index.ts",
        "start": "ts-node ./src/index.ts",
        "start:prod": "node dist/src/index.js",
        "prebuild": "npm run lint",
        "prestart": "npm run build",
        "postinstall": "npm run build",
        "lint": "tslint -c tslint.json -p tsconfig.json --fix"
    },
    "keywords": [],
    "author": "API Team",
    "license": "ISC",
    "dependencies": {
        "@socket.io/redis-emitter": "4.1.1",
        "apn": "2.2.0",
        "axios": "^1.7.7",
        "dotenv": "10.0.0",
        "fastify": "3.27.1",
        "fastify-cors": "4.1.0",
        "fastify-multer": "2.0.2",
        "fastify-oas": "3.0.8",
        "fastify-plugin": "3.0.0",
        "fcm-node": "1.6.1",
        "fs": "0.0.1-security",
        "googleapis": "^144.0.0",
        "http2": "^3.3.7",
        "ioredis": "^5.3.1",
        "jsonwebtoken": "^9.0.2",
        "log4js": "6.3.0",
        "moment": "2.29.1",
        "mssql": "7.3.0",
        "mysql": "^2.18.1",
        "mysql2": "2.3.3",
        "redis": "3.1.0",
        "sequelize": "6.20.1"
    },
    "devDependencies": {
        "@types/cors": "2.8.10",
        "@types/jsonwebtoken": "8.5.5",
        "@types/mysql": "2.15.21",
        "@types/node": "12.20.18",
        "nodemon": "2.0.16",
        "ts-node": "8.10.2",
        "tslint": "5.20.1",
        "tslint-config-airbnb": "5.11.2",
        "tslint-config-prettier": "1.18.0",
        "typescript": "4.8.3"
    }
}
